        "column_AyKpwX": {
          "type": "column",
          "settings": {
            "title": "Our Own State of Art Facility",
            "before_image": "shopify://shop_images/science_backed_tech-01.png",
            "text": "<p>Alphacentric Healthcare Pvt Ltd, based in Bangalore, is the proud manufacturer of Protyze, a premium health and wellness brand. With a commitment to quality and innovation, we bring you scientifically formulated products that empower your journey to a healthier, happier life.</p>",
