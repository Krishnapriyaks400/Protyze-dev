          "type": "text",
          "id": "heading",
          "label": "Card title",
          "default": "Description"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card subtitle"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description",
          "info": "Pull description from the product page automatically",
          "default": true
        },
        {
          "type": "richtext",
          "id": "custom_description",
          "label": "Custom description",
          "info": "Used when 'Use product description' is unchecked"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label",
          "info": "Optional link at the bottom of the card, e.g. \"Anytime Clear Whey\"."
