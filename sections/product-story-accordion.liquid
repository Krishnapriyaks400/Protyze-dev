{{ 'product-story-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ps_accent = section.settings.accent_color
  if ps_accent == blank and product
    assign ps_accent = product.metafields.custom.flavour_color.value
  endif
  if ps_accent == blank
    assign ps_accent = '#e07b28'
  endif

  assign ps_card_text = section.settings.card_text_color | default: '#ffffff'
  assign ps_fg_r = ps_card_text | color_extract: 'red'
  assign ps_fg_g = ps_card_text | color_extract: 'green'
  assign ps_fg_b = ps_card_text | color_extract: 'blue'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .ps-{{ section.id }} {
    --ps-accent: {{ ps_accent }};
    --ps-card-bg: {{ section.settings.card_bg_color | default: '#241e1a' }};
    --ps-card-fg: {{ ps_fg_r }}, {{ ps_fg_g }}, {{ ps_fg_b }};
    --ps-cols: {{ section.settings.columns_desktop }};
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="ps-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="product-story page-width section-{{ section.id }}-padding">
    {%- if section.settings.caption != blank or section.settings.heading != blank -%}
      <div class="ps__head">
        {%- if section.settings.caption != blank -%}
          <p class="ps__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ps__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Every card is pinned to the board and always shows its content. {%- endcomment -%}
    <div class="ps__cards">
      {%- for block in section.blocks -%}
        {%- assign ps_pin = block.settings.pin_color | default: ps_accent -%}
        <article
          id="story-{{ block.type }}"
          class="ps__card"
          {{ block.shopify_attributes }}
          style="--ps-pin: {{ ps_pin }};{% if block.settings.card_bg_color != blank %} --ps-item-bg: {{ block.settings.card_bg_color }};{% endif %}"
        >
          <span class="ps__pin" aria-hidden="true"></span>
          <div class="ps__card-head">
            <h3 class="ps__card-title">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.badge_text != blank -%}
              <span class="ps__card-badge">{{ block.settings.badge_text | escape }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.subtitle != blank -%}
            <p class="ps__card-sub">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}

          <div class="product-story__content">
{%- case block.type -%}

                {%- when 'description' -%}
                  <div class="product-story__description rte">
                    {%- if block.settings.use_product_description -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.custom_description }}
                    {%- endif -%}
                  </div>

                {%- when 'benefits' -%}
                  <div class="product-story__benefits">
                    <div class="product-story__benefit-grid">
                      {%- for i in (1..6) -%}
                        {%- liquid
                          assign b_title_key = 'benefit_' | append: i | append: '_title'
                          assign b_desc_key = 'benefit_' | append: i | append: '_desc'
                          assign b_icon_key = 'benefit_' | append: i | append: '_icon'
                          assign b_color_key = 'benefit_' | append: i | append: '_color'
                          assign b_title = block.settings[b_title_key]
                          assign b_desc = block.settings[b_desc_key]
                          assign b_icon = block.settings[b_icon_key]
                          assign b_color = block.settings[b_color_key]
                        -%}
                        {%- if b_title != blank -%}
                          <div class="product-story__benefit">
                            <span
                              class="product-story__benefit-icon"
                              {% if b_color != blank %}
                                style="--benefit-bg: {{ b_color }};"
                              {% endif %}
                            >
                              {%- if b_icon != blank -%}
                                {{ b_icon | image_url: width: 96 | image_tag: widths: '48, 72, 96', loading: 'lazy' }}
                              {%- endif -%}
                            </span>
                            <div class="product-story__benefit-body">
                              <p class="product-story__benefit-title">{{ b_title | escape }}</p>
                              {%- if b_desc != blank -%}
                                <p class="product-story__benefit-desc">{{ b_desc | escape }}</p>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- if block.settings.points != blank -%}
                      {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
                      <ul class="product-story__points">
                        {%- for point in points -%}
                          {%- assign point_text = point | strip -%}
                          {%- if point_text != blank -%}
                            <li>{{ point_text | escape }}</li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                {%- when 'ingredients' -%}
                  {%- assign ing_lines = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- assign ing_n = 0 -%}
                  <ol class="ps__ingredients">
                    {%- for line in ing_lines -%}
                      {%- assign ing_line = line | strip -%}
                      {%- if ing_line != blank -%}
                        {%- liquid
                          assign ing_n = ing_n | plus: 1
                          assign ing_parts = ing_line | split: '|'
                          assign ing_name = ing_parts[0] | strip
                          assign ing_note = ing_parts[1] | strip
                          assign ing_desc = ing_parts[2] | strip
                        -%}
                        <li class="ps__ingredient">
                          <span class="ps__ingredient-num" aria-hidden="true">{{ ing_n | prepend: '0' | slice: -2, 2 }}</span>
                          <div>
                            <p class="ps__ingredient-name">
                              {{- ing_name | escape -}}
                              {%- if ing_note != blank -%}
                                <span class="ps__ingredient-note"> · {{ ing_note | escape }}</span>
                              {%- endif -%}
                            </p>
                            {%- if ing_desc != blank -%}
                              <p class="ps__ingredient-desc">{{ ing_desc | escape }}</p>
                            {%- endif -%}
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ol>

                {%- when 'richtext' -%}
                  <div class="product-story__richtext rte">
                    {{ block.settings.content }}
                  </div>

                {%- when 'steps' -%}
                  <ol class="product-story__steps">
                    {%- assign step_number = 0 -%}
                    {%- for i in (1..6) -%}
                      {%- liquid
                        assign step_text_key = 'step_' | append: i | append: '_text'
                        assign step_title_key = 'step_' | append: i | append: '_title'
                        assign step_icon_key = 'step_' | append: i | append: '_icon'
                        assign step_text = block.settings[step_text_key]
                        assign step_title = block.settings[step_title_key]
                        assign step_icon = block.settings[step_icon_key]
                      -%}
                      {%- if step_text != blank -%}
                        {%- assign step_number = step_number | plus: 1 -%}
                        <li class="product-story__step">
                          <span class="product-story__step-number" aria-hidden="true">{{ step_number }}</span>
                          {%- if step_icon != blank -%}
                            <span class="product-story__step-icon">
                              {{ step_icon | image_url: width: 120 | image_tag: widths: '60, 90, 120', loading: 'lazy' }}
                            </span>
                          {%- endif -%}
                          <div class="product-story__step-body">
                            {%- if step_title != blank -%}
                              <p class="product-story__step-title">{{ step_title | escape }}</p>
                            {%- endif -%}
                            <p class="product-story__step-text">{{ step_text | escape }}</p>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ol>

                {%- when 'comparison' -%}
                  <div class="product-story__comparison">
                    <table class="product-story__table">
                      <thead>
                        <tr>
                          <th class="product-story__th product-story__th--feature">{{ block.settings.feature_label | default: 'Feature' | escape }}</th>
                          <th class="product-story__th product-story__th--col1">{{ block.settings.column1_label | default: 'Clear Whey' | escape }}</th>
                          <th class="product-story__th product-story__th--col2">{{ block.settings.column2_label | default: 'Regular Whey' | escape }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {%- for i in (1..6) -%}
                          {%- assign row_feature_key = 'row_' | append: i | append: '_feature' -%}
                          {%- assign row_col1_key = 'row_' | append: i | append: '_col1' -%}
                          {%- assign row_col2_key = 'row_' | append: i | append: '_col2' -%}
                          {%- assign row_feature = block.settings[row_feature_key] -%}
                          {%- if row_feature != blank -%}
                            <tr>
                              <td class="product-story__td product-story__td--feature">{{ row_feature | escape }}</td>
                              <td class="product-story__td product-story__td--col1">{{ block.settings[row_col1_key] | escape }}</td>
                              <td class="product-story__td product-story__td--col2">{{ block.settings[row_col2_key] | escape }}</td>
                            </tr>
                          {%- endif -%}
                        {%- endfor -%}
                      </tbody>
                    </table>
                    {%- if block.settings.table_footnote != blank -%}
                      <p class="product-story__footnote">{{ block.settings.table_footnote }}</p>
                    {%- endif -%}
                  </div>

              {%- endcase -%}
          </div>

          {%- if block.settings.button_label != blank -%}
            <a
              class="ps__card-link"
              {% if block.settings.button_link != blank %}
                href="{{ block.settings.button_link }}"
              {% else %}
                href="#" aria-disabled="true"
              {% endif %}
            >
              {{- block.settings.button_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 12h16M14 6l6 6-6 6"/>
              </svg>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Story Cards",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Small label above the heading. Leave empty to hide.",
      "default": "Shop by goal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What are you working on?"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background (the board)",
      "info": "Optional. Overrides the colour scheme background."
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#241e1a"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "info": "Default pin colour, list dots and step numbers. Leave empty to use the product's custom.flavour_color metafield."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
