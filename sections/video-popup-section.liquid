{% schema %}
{
  "name": "Video Carousel Popup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Our Videos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
  "type": "video",
  "name": "Video Slide",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Video File"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt Text",
      "default": "Video thumbnail"
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop video",
      "default": false
    }
  ]
}
  ],
  "presets": [
    {
      "name": "Video Carousel Popup",
      "blocks": [
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}


<div class="video-carousel-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="video-carousel swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide">
            <deferred-media
              class="video-slide deferred-media"
              data-media-id="video-{{ block.id }}"
            >
              <button
                id="Deferred-Poster-Modal-{{ block.id }}"
                class="deferred-media__poster media--landscape"
                type="button"
                aria-label="{{ block.settings.alt_text | escape }}"
                data-modal-open
                data-index="{{ forloop.index0 }}"
              >
                {%- if block.settings.poster != blank -%}
                  {{
                    block.settings.poster
                    | image_url: width: 1000
                    | image_tag: width: null, alt: block.settings.alt_text
                  }}
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
                <span class="deferred-media__poster-button">
                  <span class="svg-wrapper">
                    {{ 'icon-play.svg' | inline_asset_content }}
                  </span>
                </span>
              </button>
            </deferred-media>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div class="video-modal hidden" id="videoModal">
    <div class="video-modal__overlay" data-modal-close></div>
    <div class="video-modal__content">
      <button class="video-modal__close" data-modal-close>&times;</button>
      <div class="swiper popup-swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide">
              <deferred-media
                class="popup-video deferred-media"
                data-media-id="popup-video-{{ block.id }}"
              >
                <template>
                  {%- if block.settings.video == blank and block.settings.video_url != blank -%}
                    {%- assign video_id = block.settings.video_url.id -%}
                    {%- assign loop = block.settings.loop_video | default: false -%}
                    {%- assign loop_param = '' -%}
                    {%- if loop -%}
                      {%- assign loop_param = '&loop=1&playlist=' | append: video_id -%}
                    {%- endif -%}
                    {%- if block.settings.video_url.type == 'youtube' -%}
                      <iframe
                        src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop_param }}"
                        class="js-youtube"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                        title="{{ block.settings.alt_text }}"
                      ></iframe>
                    {%- else -%}
                      <iframe
                        src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop_param }}"
                        class="js-vimeo"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                        title="{{ block.settings.alt_text }}"
                      ></iframe>
                    {%- endif -%}
                  {%- else -%}
                    {{
                      block.settings.video
                      | video_tag:
                          autoplay: true,
                          loop: block.settings.loop_video,
                          controls: true,
                          muted: false
                    }}
                  {%- endif -%}
                </template>
              </deferred-media>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>


<style>
.video-carousel-section {
  padding: 20px;
}
.video-carousel .swiper-slide {
  width: 220px;
  height: auto;
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
  background: #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}
.video-frame {
  width: 100%;
  height: 360px;
  overflow: hidden;
}
.carousel-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.linked-product {
  text-align: center;
  padding: 8px;
}
.linked-product img {
  width: 60px;
  height: 60px;
  object-fit: contain;
  margin-bottom: 4px;
}
.product-title {
  font-size: 14px;
  font-weight: 600;
}

/* Modal styles */
.video-modal {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(0,0,0,0.8);
  width: 100%;
  height: 100%;
}
.video-modal.hidden {
  display: none;
}
.modal-content {
  background: white;
  width: 90%;
  max-width: 800px;
  padding: 20px;
  border-radius: 10px;
  position: relative;
}
.modal-content video {
  width: 100%;
  height: auto;
  border-radius: 10px;
}
.close-modal {
  position: absolute;
  top: 10px;
  right: 14px;
  font-size: 28px;
  font-weight: bold;
  cursor: pointer;
}
.product-info {
  text-align: center;
  margin-top: 10px;
}
.product-info img {
  width: 80px;
  height: auto;
  margin-bottom: 10px;
}
.product-info .btn {
  display: inline-block;
  margin-top: 5px;
  background: black;
  color: white;
  padding: 8px 12px;
  border-radius: 6px;
  text-decoration: none;
}
</style>

<script>
document.querySelectorAll('[data-modal-open]').forEach((btn, i) => {
  btn.addEventListener('click', () => {
    const modal = document.getElementById('videoModal');
    modal.classList.remove('hidden');
    const swiper = document.querySelector('.popup-swiper').swiper;
    swiper.slideTo(i);
  });
});

document.querySelectorAll('[data-modal-close]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('videoModal').classList.add('hidden');
  });
});


  closeBtn.addEventListener("click", () => {
    modal.classList.add("hidden");
    document.querySelectorAll(".modal-content video").forEach(video => video.pause());
  });
});
</script>
