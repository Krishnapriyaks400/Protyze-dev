{{ 'product-story-accordion_copy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ps_accent = section.settings.accent_color
  if ps_accent == blank and product
    assign ps_accent = product.metafields.custom.flavour_color.value
  endif
  if ps_accent == blank
    assign ps_accent = '#e07b28'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="--ps-accent: {{ ps_accent }};">
  <div class="product-story product-story--image-{{ section.settings.image_position }} page-width section-{{ section.id }}-padding">
    <div class="product-story__layout{% if section.settings.side_image == blank %} product-story__layout--no-image{% endif %}">
      {%- if section.settings.side_image != blank -%}
        <div class="product-story__image">
          {{
            section.settings.side_image
            | image_url: width: 1200
            | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
          }}
        </div>
      {%- endif -%}

      <div class="product-story__main">
    <div class="product-story__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.caption != blank -%}
        <p class="product-story__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="product-story__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
    </div>

      <div class="product-story__items" id="ProductStoryItems-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="product-story__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          style="--card-bg: {{ block.settings.card_bg_color }};animation-delay: {{ forloop.index | times: 100 }}ms;"
        >
          <details id="ProductStory-{{ block.id }}-{{ section.id }}"{% if section.settings.open_first and forloop.first %} open{% endif %}>
            <summary class="product-story__summary">
              <div class="product-story__summary-left">
                {%- if block.settings.icon_image != blank -%}
                  <div class="product-story__icon">
                    {{ block.settings.icon_image | image_url: width: 80 | image_tag: widths: '40, 60, 80', loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <div class="product-story__summary-text">
                  <h3 class="product-story__title">{{ block.settings.heading | escape }}</h3>
                  {%- if block.settings.subtitle != blank -%}
                    <p class="product-story__subtitle">{{ block.settings.subtitle | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
              <span class="product-story__toggle">
                <svg class="product-story__plus" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <svg class="product-story__close" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 10H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
            </summary>

            <div class="product-story__content" id="ProductStoryContent-{{ block.id }}-{{ section.id }}">
              {%- case block.type -%}

                {%- when 'description' -%}
                  <div class="product-story__description rte">
                    {%- if block.settings.use_product_description -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.custom_description }}
                    {%- endif -%}
                  </div>

                {%- when 'benefits' -%}
                  <div class="product-story__benefits">
                    <div class="product-story__benefit-grid">
                      {%- for i in (1..6) -%}
                        {%- liquid
                          assign b_title_key = 'benefit_' | append: i | append: '_title'
                          assign b_desc_key = 'benefit_' | append: i | append: '_desc'
                          assign b_icon_key = 'benefit_' | append: i | append: '_icon'
                          assign b_color_key = 'benefit_' | append: i | append: '_color'
                          assign b_title = block.settings[b_title_key]
                          assign b_desc = block.settings[b_desc_key]
                          assign b_icon = block.settings[b_icon_key]
                          assign b_color = block.settings[b_color_key]
                        -%}
                        {%- if b_title != blank -%}
                          <div class="product-story__benefit">
                            <span
                              class="product-story__benefit-icon"
                              {% if b_color != blank %}
                                style="--benefit-bg: {{ b_color }};"
                              {% endif %}
                            >
                              {%- if b_icon != blank -%}
                                {{ b_icon | image_url: width: 96 | image_tag: widths: '48, 72, 96', loading: 'lazy' }}
                              {%- endif -%}
                            </span>
                            <div class="product-story__benefit-body">
                              <p class="product-story__benefit-title">{{ b_title | escape }}</p>
                              {%- if b_desc != blank -%}
                                <p class="product-story__benefit-desc">{{ b_desc | escape }}</p>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- if block.settings.points != blank -%}
                      {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
                      <ul class="product-story__points">
                        {%- for point in points -%}
                          {%- assign point_text = point | strip -%}
                          {%- if point_text != blank -%}
                            <li>{{ point_text | escape }}</li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                {%- when 'richtext' -%}
                  <div class="product-story__richtext rte">
                    {{ block.settings.content }}
                  </div>

                {%- when 'steps' -%}
                  <ol class="product-story__steps">
                    {%- assign step_number = 0 -%}
                    {%- for i in (1..6) -%}
                      {%- liquid
                        assign step_text_key = 'step_' | append: i | append: '_text'
                        assign step_title_key = 'step_' | append: i | append: '_title'
                        assign step_icon_key = 'step_' | append: i | append: '_icon'
                        assign step_text = block.settings[step_text_key]
                        assign step_title = block.settings[step_title_key]
                        assign step_icon = block.settings[step_icon_key]
                      -%}
                      {%- if step_text != blank -%}
                        {%- assign step_number = step_number | plus: 1 -%}
                        <li class="product-story__step">
                          <span class="product-story__step-number" aria-hidden="true">{{ step_number }}</span>
                          {%- if step_icon != blank -%}
                            <span class="product-story__step-icon">
                              {{ step_icon | image_url: width: 120 | image_tag: widths: '60, 90, 120', loading: 'lazy' }}
                            </span>
                          {%- endif -%}
                          <div class="product-story__step-body">
                            {%- if step_title != blank -%}
                              <p class="product-story__step-title">{{ step_title | escape }}</p>
                            {%- endif -%}
                            <p class="product-story__step-text">{{ step_text | escape }}</p>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ol>

                {%- when 'comparison' -%}
                  <div class="product-story__comparison">
                    <table class="product-story__table">
                      <thead>
                        <tr>
                          <th class="product-story__th product-story__th--feature">{{ block.settings.feature_label | default: 'Feature' | escape }}</th>
                          <th class="product-story__th product-story__th--col1">{{ block.settings.column1_label | default: 'Clear Whey' | escape }}</th>
                          <th class="product-story__th product-story__th--col2">{{ block.settings.column2_label | default: 'Regular Whey' | escape }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {%- for i in (1..6) -%}
                          {%- assign row_feature_key = 'row_' | append: i | append: '_feature' -%}
                          {%- assign row_col1_key = 'row_' | append: i | append: '_col1' -%}
                          {%- assign row_col2_key = 'row_' | append: i | append: '_col2' -%}
                          {%- assign row_feature = block.settings[row_feature_key] -%}
                          {%- if row_feature != blank -%}
                            <tr>
                              <td class="product-story__td product-story__td--feature">{{ row_feature | escape }}</td>
                              <td class="product-story__td product-story__td--col1">{{ block.settings[row_col1_key] | escape }}</td>
                              <td class="product-story__td product-story__td--col2">{{ block.settings[row_col2_key] | escape }}</td>
                            </tr>
                          {%- endif -%}
                        {%- endfor -%}
                      </tbody>
                    </table>
                    {%- if block.settings.table_footnote != blank -%}
                      <p class="product-story__footnote">{{ block.settings.table_footnote }}</p>
                    {%- endif -%}
                  </div>

              {%- endcase -%}
            </div>
          </details>
        </div>
      {%- endfor -%}
      </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.exclusive_mode -%}
  <script>
    (function(){
      var container = document.getElementById('ProductStoryItems-{{ section.id }}');
      if (!container) return;
      container.addEventListener('click', function(e) {
        var summary = e.target.closest('summary');
        if (!summary) return;
        var parent = summary.closest('details');
        var all = container.querySelectorAll('details[open]');
        for (var i = 0; i < all.length; i++) {
          if (all[i] !== parent) all[i].removeAttribute('open');
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product Story Accordion",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Small label above the heading. Leave empty to hide."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why Protyze Clear Whey?"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Toggle icons, list dots and step numbers. Leave empty to use the product's custom.flavour_color metafield."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "exclusive_mode",
      "label": "Close others when one opens",
      "info": "Only one accordion open at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Image",
      "info": "Recommended 1200 × 1200 px (square). Shown above the accordion on mobile."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
