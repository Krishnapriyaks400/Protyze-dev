{{ 'product-highlights.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}

<section
  class="ph-section color-{{ section.settings.color_scheme }} gradient"
  id="ph-section-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width ph-section__wrapper">

    {%- comment -%} Section header {%- endcomment -%}
    <div class="ph-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ph-section__eyebrow">
          <span class="ph-section__eyebrow-dot" style="background: {{ section.settings.accent_color }};"></span>
          {{ section.settings.eyebrow | escape | upcase }}
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ph-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="ph-section__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} 2-column layout {%- endcomment -%}
    <div class="ph-section__layout">

      {%- comment -%} LEFT: image panel {%- endcomment -%}
      <div class="ph-section__media-panel" style="background: {{ section.settings.panel_bg_color }};">

        {%- for block in section.blocks -%}
          <div
            class="ph-section__media-item{% if forloop.first %} is-active{% endif %}"
            id="ph-img-{{ section.id }}-{{ block.id }}"
          >
            {%- if block.settings.image != blank -%}
              {%- assign ph_alt = block.settings.title | escape -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 749px) 100vw, 55vw"
                alt="{{ ph_alt }}"
                class="ph-section__img"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- else -%}
              <div class="ph-section__img-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%} Stat badges — one per block, swapped by JS {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.stat_number != blank -%}
            <div
              class="ph-section__stat{% if forloop.first %} is-active{% endif %}"
              id="ph-stat-{{ section.id }}-{{ block.id }}"
            >
              <span class="ph-section__stat-num" style="color: {{ section.settings.accent_color }};">
                {{- block.settings.stat_number | escape -}}
              </span>
              {%- if block.settings.stat_label != blank -%}
                <span class="ph-section__stat-label">{{ block.settings.stat_label | escape | upcase }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>

      {%- comment -%} RIGHT: highlight items {%- endcomment -%}
      <div class="ph-section__items">
        {%- for block in section.blocks -%}
          {%- assign ph_num = forloop.index -%}
          <div
            class="ph-section__item{% if forloop.first %} is-active{% endif %}"
            id="ph-item-{{ section.id }}-{{ block.id }}"
            data-img-id="ph-img-{{ section.id }}-{{ block.id }}"
            data-stat-id="ph-stat-{{ section.id }}-{{ block.id }}"
            {{ block.shopify_attributes }}
            role="button"
            tabindex="0"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            style="--ph-accent: {{ section.settings.accent_color }};"
          >
            <span class="ph-section__item-num">
              {%- if ph_num < 10 -%}0{{ ph_num }}{%- else -%}{{ ph_num }}{%- endif -%}
            </span>
            <div class="ph-section__item-body">
              <p class="ph-section__item-title">{{ block.settings.title | escape }}</p>
              {%- if block.settings.description != blank -%}
                <p class="ph-section__item-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('ph-section-{{ section.id }}');
  if (!section) return;

  var items  = section.querySelectorAll('.ph-section__item');
  var images = section.querySelectorAll('.ph-section__media-item');
  var stats  = section.querySelectorAll('.ph-section__stat');

  function activate(item) {
    items.forEach(function (el)  { el.classList.remove('is-active'); el.setAttribute('aria-pressed', 'false'); });
    images.forEach(function (el) { el.classList.remove('is-active'); });
    stats.forEach(function (el)  { el.classList.remove('is-active'); });

    item.classList.add('is-active');
    item.setAttribute('aria-pressed', 'true');

    var imgEl  = document.getElementById(item.dataset.imgId);
    var statEl = document.getElementById(item.dataset.statId);
    if (imgEl)  imgEl.classList.add('is-active');
    if (statEl) statEl.classList.add('is-active');
  }

  items.forEach(function (item) {
    item.addEventListener('click', function () { activate(item); });
    item.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(item); }
    });
  });
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Product Highlights",
  "tag": "section",
  "class": "section-product-highlights",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Product Highlights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore what makes it different"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Tap any highlight to see how Protyze <strong>clear whey protein</strong> works for you — a light, fast-absorbing whey isolate with none of the fillers.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for item numbers and stat value",
      "default": "#e91e63"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Image panel background",
      "default": "#fce4ec"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (shown on left when active)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rapid absorption"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (shown when active)",
          "default": "You feel fuelled within minutes of your last rep — no waiting for a heavy shake to settle."
        },
        {
          "type": "text",
          "id": "stat_number",
          "label": "Stat number",
          "info": "Large value shown bottom-left of image, e.g. ~15 min"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat label",
          "info": "Small label next to stat, e.g. TO REACH YOUR MUSCLES"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Highlights",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "Rapid absorption",
            "description": "You feel fuelled within minutes of your last rep — no waiting for a heavy shake to settle.",
            "stat_number": "~15 min",
            "stat_label": "TO REACH YOUR MUSCLES"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "99% lactose free",
            "description": "Gentle on the stomach — ideal for those with mild lactose sensitivity."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Light & refreshing",
            "description": "Drinks like juice, not a thick milkshake. Perfect post-workout hydration."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Easy to digest",
            "description": "Whey isolate is stripped of most fats and carbs for faster, easier digestion."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "No artificial colours",
            "description": "Clean formula — no synthetic dyes or unnecessary additives."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "No gums or thickeners",
            "description": "Pure and transparent — what you see is what you get."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}
