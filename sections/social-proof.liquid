{{ 'social-proof.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}

<section
  class="social-proof color-{{ section.settings.color_scheme }} gradient"
  id="social-proof-{{ section.id }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width social-proof__wrapper">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="social-proof__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="social-proof__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="social-proof__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="social-proof__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="social-proof__grid"
      style="--sp-cols: {{ section.settings.columns_desktop }};"
    >
      {%- for block in section.blocks -%}
        <div
          class="social-proof__card"
          {{ block.shopify_attributes }}
          style="
            background: {{ block.settings.card_bg_color }};
            {%- if block.settings.card_border_color != blank and block.settings.card_border_color != 'rgba(0,0,0,0)' -%}
              border-color: {{ block.settings.card_border_color }};
            {%- endif -%}
          "
        >
          <div class="social-proof__card-image">
            {%- if block.settings.image != blank -%}
              {%- assign sp_alt = block.settings.name | escape -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 600 }} 600w"
                sizes="(max-width: 749px) calc(50vw - 2rem), calc(25vw - 2rem)"
                alt="{{ sp_alt }}"
                class="social-proof__img"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- else -%}
              <div class="social-proof__img-placeholder">
                <span class="social-proof__img-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </span>
              </div>
            {%- endif -%}
          </div>

          <div class="social-proof__card-body">
            {%- if block.settings.name != blank -%}
              <p class="social-proof__name">{{ block.settings.name | escape }}</p>
            {%- endif -%}
            {%- if block.settings.tag_text != blank -%}
              <span class="social-proof__tag" style="background: {{ block.settings.tag_bg_color }};">
                <span class="social-proof__tag-dot" style="background: {{ block.settings.tag_dot_color }};"></span>
                {{ block.settings.tag_text | escape }}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{%- endif -%}

{% schema %}
{
  "name": "Social Proof",
  "tag": "section",
  "class": "section-social-proof",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 10,000+ fitness enthusiasts across India"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Real people chasing real goals, fuelled by Protyze <strong>clear whey protein</strong> — 24g protein, zero added sugar, and light enough to drink every day. Meet a few of them.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Person card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Arjun M."
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag label",
          "default": "Lost 8 kg"
        },
        {
          "type": "color",
          "id": "tag_dot_color",
          "label": "Tag dot color",
          "default": "#e91e63"
        },
        {
          "type": "color",
          "id": "tag_bg_color",
          "label": "Tag background color",
          "default": "#fce4ec"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "card_border_color",
          "label": "Card border color",
          "default": "#e8e8e8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof",
      "blocks": [
        { "type": "card", "settings": { "name": "Arjun M.", "tag_text": "Lost 8 kg" } },
        { "type": "card", "settings": { "name": "Sneha R.", "tag_text": "Building strength" } },
        { "type": "card", "settings": { "name": "Priya K.", "tag_text": "Toned & fit" } },
        { "type": "card", "settings": { "name": "Rohit S.", "tag_text": "Marathon training" } },
        { "type": "card", "settings": { "name": "Karan V.", "tag_text": "Court endurance" } },
        { "type": "card", "settings": { "name": "Dev P.", "tag_text": "Contest prep" } },
        { "type": "card", "settings": { "name": "Ananya T.", "tag_text": "Daily energy" } },
        { "type": "card", "settings": { "name": "Meera J.", "tag_text": "Post-pregnancy fitness" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}
