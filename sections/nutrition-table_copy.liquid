        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Looking to increase daily protein."
        }
      ]
    },
    {
      "type": "occasion",
      "name": "When to drink",
      "limit": 9,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun" },
            { "value": "dumbbell", "label": "Dumbbell" },
            { "value": "loop", "label": "Loop" },
            { "value": "heart", "label": "Heart" },
            { "value": "glass", "label": "Glass" },
            { "value": "moon", "label": "Moon" },
            { "value": "cup", "label": "Cup" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "person", "label": "Person" },
            { "value": "clock", "label": "Clock" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sun"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon",
          "info": "Optional — replaces the icon above. Transparent PNG/SVG, 72 × 72 px."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Morning"
