      ]
    }
  ],
  "presets": [
    {
      "name": "Nutrition & usage",
      "category": "Custom",
      "blocks": [
        { "type": "row", "settings": { "label": "Energy", "value": "90 kcal" } },
        { "type": "row", "settings": { "label": "Protein", "value": "24 g" } },
