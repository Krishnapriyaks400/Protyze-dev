{{ 'nutrition-stats.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }
  @media screen and (min-width: 576px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="nutrition-stats page-width section-{{ section.id }}-padding">
    <div class="nutrition-stats__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.caption != blank -%}
        <p class="nutrition-stats__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nutrition-stats__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
    </div>

    <div class="nutrition-stats__grid nutrition-stats__grid--{{ section.blocks.size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- for block in section.blocks -%}
        <div
          class="nutrition-stats__card"
          style="--card-bg: {{ block.settings.card_bg_color }};--value-color: {{ block.settings.value_color }};"
          {{ block.shopify_attributes }}
        >
          <span class="nutrition-stats__value">
            {{- block.settings.value -}}<span class="nutrition-stats__unit">{{ block.settings.unit }}</span>
          </span>
          <span class="nutrition-stats__label">{{ block.settings.label | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nutrition Stats",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "3X ABSORPTION · 2-IN-1 BENEFITS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Every scoop, <strong>fully loaded</strong>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Card",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "24"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit",
          "default": "g",
          "info": "e.g. g, mg, %"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Protein"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background",
          "default": "#fdd7e4"
        },
        {
          "type": "color",
          "id": "value_color",
          "label": "Value text color",
          "default": "#e91e63"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nutrition Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "24",
            "unit": "g",
            "label": "Protein",
            "card_bg_color": "#fdd7e4",
            "value_color": "#e91e63"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "4",
            "unit": "g",
            "label": "Glutamine",
            "card_bg_color": "#d5f5e3",
            "value_color": "#2e7d32"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "3.8",
            "unit": "g",
            "label": "Leucine",
            "card_bg_color": "#fdf2d1",
            "value_color": "#e67e22"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "7.2",
            "unit": "g",
            "label": "BCAA",
            "card_bg_color": "#d8d5f7",
            "value_color": "#7b1fa2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
