{% comment %}
  Compact "compare the range" table.
  Column names and colours are section settings (up to 5); each row is a block with one value per column.
{% endcomment %}

{%- liquid
  assign rc_rows = section.blocks | where: 'type', 'row'
  assign rc_cols = 0
  for i in (1..5)
    assign col_key = 'column_' | append: i
    if section.settings[col_key] != blank
      assign rc_cols = i
    endif
  endfor
-%}

{%- if section.settings.load_fonts -%}
  {%- comment -%} Same fonts as the Flavour hero carousel and Shop by goal; the browser downloads them once. {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@400;700;800&family=Sacramento&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{%- style -%}
  /* Element + class beats the theme's "body .color-scheme-x" background/text rule. */
  div.rc-{{ section.id }} {
    --rc-bg: {{ section.settings.background_color }};
    --rc-text: {{ section.settings.text_color }};
    --rc-line: {{ section.settings.text_color | color_modify: 'alpha', 0.14 }};
    background: var(--rc-bg);
    color: var(--rc-text);
    font-family: 'Outfit', var(--font-body-family), system-ui, sans-serif;
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }
  .rc-{{ section.id }} .rc__heading {
    color: var(--rc-text);
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 1.4rem;
  }
  .rc-{{ section.id }} .rc__panel {
    border: 1px solid var(--rc-line);
    border-radius: 1.4rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .rc-{{ section.id }} .rc__table {
    border-collapse: collapse;
    min-width: calc(12rem + {{ rc_cols | at_least: 1 }} * 14rem);
    width: 100%;
  }
  .rc-{{ section.id }} .rc__table th,
  .rc-{{ section.id }} .rc__table td {
    font-size: 1.3rem;
    padding: 1.3rem 1.6rem;
    text-align: left;
    vertical-align: top;
  }
  .rc-{{ section.id }} .rc__table tr + tr th,
  .rc-{{ section.id }} .rc__table tr + tr td {
    border-top: 1px solid var(--rc-line);
  }
  .rc-{{ section.id }} .rc__col {
    font-family: 'Anton', var(--font-heading-family), sans-serif;
    font-weight: 400;
    font-size: 1.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .rc-{{ section.id }} .rc__label {
    background: var(--rc-bg);
    font-weight: 700;
    left: 0;
    position: sticky;
    white-space: nowrap;
    z-index: 1;
  }
  .rc-{{ section.id }} .rc__value {
    opacity: 0.88;
  }

  @media screen and (min-width: 750px) {
    div.rc-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .rc-{{ section.id }} .rc__table th,
    .rc-{{ section.id }} .rc__table td {
      font-size: 1.4rem;
      padding: 1.4rem 2rem;
    }
  }
{%- endstyle -%}

<div class="rc-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="rc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if rc_cols > 0 and rc_rows.size > 0 -%}
      <div class="rc__panel">
        <table class="rc__table">
          <thead>
            <tr>
              <th class="rc__label" scope="col"><span class="visually-hidden">{{ section.settings.heading | escape }}</span></th>
              {%- for i in (1..rc_cols) -%}
                {%- liquid
                  assign col_key = 'column_' | append: i
                  assign color_key = 'column_' | append: i | append: '_color'
                -%}
                <th class="rc__col" scope="col" style="color: {{ section.settings[color_key] }};">
                  {{- section.settings[col_key] | escape -}}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in rc_rows -%}
              <tr {{ block.shopify_attributes }}>
                <th class="rc__label" scope="row">{{ block.settings.label | escape }}</th>
                {%- for i in (1..rc_cols) -%}
                  {%- assign value_key = 'value_' | append: i -%}
                  <td class="rc__value">{{ block.settings[value_key] | default: '—' }}</td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Range compare table",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare the range at a glance" },
    { "type": "header", "content": "Columns", "info": "Leave a column name empty to hide it." },
    { "type": "text", "id": "column_1", "label": "Column 1", "default": "Anytime" },
    { "type": "color", "id": "column_1_color", "label": "Column 1 colour", "default": "#f37aa8" },
    { "type": "text", "id": "column_2", "label": "Column 2", "default": "Diet" },
    { "type": "color", "id": "column_2_color", "label": "Column 2 colour", "default": "#7fd6b5" },
    { "type": "text", "id": "column_3", "label": "Column 3", "default": "Nitro" },
    { "type": "color", "id": "column_3_color", "label": "Column 3 colour", "default": "#ffb36b" },
    { "type": "text", "id": "column_4", "label": "Column 4", "default": "Hydra" },
    { "type": "color", "id": "column_4_color", "label": "Column 4 colour", "default": "#ff8a7a" },
    { "type": "text", "id": "column_5", "label": "Column 5" },
    { "type": "color", "id": "column_5_color", "label": "Column 5 colour", "default": "#fbeee4" },
    {
      "type": "checkbox",
      "id": "load_fonts",
      "label": "Load Google fonts",
      "info": "Anton (column names) and Outfit (text), same as the Flavour hero carousel. Untick if the theme already loads them.",
      "default": true
    },
    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#2b0a1c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#fbeee4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Protein / serving" },
        { "type": "inline_richtext", "id": "value_1", "label": "Column 1 value" },
        { "type": "inline_richtext", "id": "value_2", "label": "Column 2 value" },
        { "type": "inline_richtext", "id": "value_3", "label": "Column 3 value" },
        { "type": "inline_richtext", "id": "value_4", "label": "Column 4 value" },
        { "type": "inline_richtext", "id": "value_5", "label": "Column 5 value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Range compare table",
      "blocks": [
        {
          "type": "row",
          "settings": { "label": "Protein / serving", "value_1": "24g", "value_2": "15g", "value_3": "30g", "value_4": "20g" }
        },
        {
          "type": "row",
          "settings": {
            "label": "Also inside",
            "value_1": "7.2g BCAA, 5g glutamine",
            "value_2": "4.5bn CFU probiotics, 500mg L-carnitine",
            "value_3": "3g creatine, 5g glutamine",
            "value_4": "810mg electrolytes, 7.6g BCAA"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Best for",
            "value_1": "Everyday protein",
            "value_2": "Gut health & weight management",
            "value_3": "Strength & muscle growth",
            "value_4": "Hydration & endurance"
          }
        },
        {
          "type": "row",
          "settings": { "label": "Starts at", "value_1": "₹999", "value_2": "₹799", "value_3": "₹1,449", "value_4": "₹998" }
        }
      ]
    }
  ]
}
{% endschema %}
