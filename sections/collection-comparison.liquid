          "label": "Row 1"
        },
        {
          "type": "inline_richtext",
          "id": "row_2",
          "label": "Row 2"
        },
        {
          "type": "inline_richtext",
          "id": "row_3",
          "label": "Row 3"
        },
        {
          "type": "inline_richtext",
          "id": "row_4",
          "label": "Row 4"
        },
        {
          "type": "inline_richtext",
          "id": "row_5",
          "label": "Row 5"
        },
        {
          "type": "inline_richtext",
          "id": "row_6",
          "label": "Row 6"
        },
        {
          "type": "inline_richtext",
          "id": "row_7",
          "label": "Row 7"
        },
        {
