{%- liquid
  assign fallback_image = section.settings.image | default: section.settings.image_mobile
  assign desktop_image = section.settings.image | default: fallback_image
  assign mobile_image = section.settings.image_mobile | default: fallback_image
  assign image_width_1x = section.settings.image_width | default: 420
  assign image_width_1_5x = image_width_1x | times: 1.5 | round: 0
  assign image_width_2x = image_width_1x | times: 2

  assign img_loading = 'lazy'
  assign img_fetchpriority = 'auto'
  if section.index == 1
    assign img_loading = 'eager'
    assign img_fetchpriority = 'high'
  endif

  assign has_content = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtitle != blank
    assign has_content = true
  endif

  assign has_media = false
  if fallback_image != blank
    assign has_media = true
  endif

  assign has_stats = false
  for block in section.blocks
    if block.type == 'stat'
      assign has_stats = true
      break
    endif
  endfor
-%}
{%- capture mobile_grid_areas -%}
  {%- if has_content -%}"content" {% endif -%}
  {%- if has_media -%}"media" {% endif -%}
  {%- if has_stats -%}"stats" {% endif -%}
{%- endcapture -%}
{%- capture desktop_grid_areas -%}
  {%- if has_content -%}"content{% if has_media %} media{% endif %}" {% endif -%}
  {%- if has_stats -%}"stats{% if has_media %} media{% endif %}" {% endif -%}
{%- endcapture -%}
{%- if has_media -%}
  {%- assign desktop_grid_columns = 'minmax(0, 1fr) minmax(0, 1fr)' -%}
{%- else -%}
  {%- assign desktop_grid_columns = 'minmax(0, 1fr)' -%}
{%- endif -%}
{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .prep-steps-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      --psb-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.eyebrow_color != blank -%}
      --psb-eyebrow-color: {{ section.settings.eyebrow_color }};
    {%- endif -%}
    {%- if section.settings.subtitle_color != blank -%}
      --psb-subtitle-color: {{ section.settings.subtitle_color }};
    {%- endif -%}
    {%- if section.settings.card_background_color != blank -%}
      --psb-card-bg: {{ section.settings.card_background_color }};
    {%- endif -%}
    {%- if section.settings.card_heading_color != blank -%}
      --psb-card-heading: {{ section.settings.card_heading_color }};
    {%- endif -%}
    {%- if section.settings.card_description_color != blank -%}
      --psb-card-description: {{ section.settings.card_description_color }};
    {%- endif -%}
    --psb-image-width: {{ image_width_1x }}px;
  }

  .prep-steps__wrapper {
    background-color: var(--psb-bg, rgb(var(--color-background)));
  }

  .prep-steps__grid {
    display: grid;
    gap: 2.4rem;
    grid-template-areas: {{ mobile_grid_areas }};
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__grid {
      align-items: start;
      column-gap: 4rem;
      grid-template-areas: {{ desktop_grid_areas }};
      grid-template-columns: {{ desktop_grid_columns }};
      row-gap: 3.2rem;
    }
  }

  .prep-steps__content {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    grid-area: content;
  }

  .prep-steps__eyebrow {
    color: var(--psb-eyebrow-color, rgb(var(--color-foreground)));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    margin: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .prep-steps__heading {
    color: rgb(var(--color-foreground));
    margin: 0;
    text-align: center;
    text-transform: none;
  }

  .prep-steps__subtitle {
    color: var(--psb-subtitle-color, rgba(var(--color-foreground), 0.7));
    margin: 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__eyebrow,
    .prep-steps__heading,
    .prep-steps__subtitle {
      text-align: left;
    }
  }

  .prep-steps__media {
    grid-area: media;
  }

  .prep-steps__image {
    border-radius: 0.8rem;
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 100%;
    width: min(100%, var(--psb-image-width, 420px));
  }

  @media screen and (min-width: 750px) {
    .prep-steps__image {
      margin: 0 0 0 auto;
    }
  }

  .prep-steps__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    grid-area: stats;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__stats {
      gap: 1.2rem;
      justify-content: flex-start;
    }
  }

  .prep-steps__stat {
    background-color: var(--psb-card-bg, rgb(var(--color-background)));
    border-radius: 0.8rem;
    text-align: center;
  }

  .prep-steps__stat--icon {
    flex: 0 0 auto;
    padding: 0.5rem;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__stat--icon {
      padding: 0.8rem;
    }
  }

  .prep-steps__stat--text {
    flex: 0 1 14rem;
    min-width: 0;
    padding: 1.4rem 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__stat--text {
      flex-basis: 12.5rem;
      padding: 1.4rem 1.2rem;
    }
  }

  .prep-steps__stat-icon {
    display: block;
    height: 4rem;
    margin: 0 auto;
    width: 4rem;
  }

  @media screen and (min-width: 750px) {
    .prep-steps__stat-icon {
      height: 5.6rem;
      width: 5.6rem;
    }
  }

  .prep-steps__stat-icon img {
    display: block;
    height: 100%;
    margin: 0 auto;
    object-fit: contain;
    width: 100%;
  }

  .prep-steps__stat-value {
    color: var(--psb-card-heading, var(--psb-eyebrow-color, rgb(var(--color-foreground))));
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .prep-steps__stat-label {
    color: var(--psb-card-description, rgba(var(--color-foreground), 0.65));
    display: block;
    font-size: 1.2rem;
  }

{% endstyle %}

<div class="prep-steps-{{ section.id }} color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="prep-steps__wrapper">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="prep-steps__grid">
        <div class="prep-steps__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="prep-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="prep-steps__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <div class="prep-steps__subtitle rte">{{ section.settings.subtitle }}</div>
          {%- endif -%}
        </div>

        <div class="prep-steps__media">
          {%- if fallback_image != blank -%}
            <picture>
              {%- if mobile_image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{- mobile_image | image_url: width: image_width_1x }} {{ image_width_1x }}w,
                    {{ mobile_image | image_url: width: image_width_1_5x }} {{ image_width_1_5x }}w,
                    {{ mobile_image | image_url: width: image_width_2x }} {{ image_width_2x }}w
                  "
                  sizes="min(100vw, {{ image_width_1x }}px)"
                >
              {%- endif -%}
              {%- if desktop_image != blank -%}
                <source
                  media="(min-width: 750px)"
                  srcset="
                    {{- desktop_image | image_url: width: image_width_1x }} {{ image_width_1x }}w,
                    {{ desktop_image | image_url: width: image_width_1_5x }} {{ image_width_1_5x }}w,
                    {{ desktop_image | image_url: width: image_width_2x }} {{ image_width_2x }}w
                  "
                  sizes="{{ image_width_1x }}px"
                >
              {%- endif -%}
              <img
                src="{{ fallback_image | image_url: width: image_width_1x }}"
                srcset="
                  {{- fallback_image | image_url: width: image_width_1x }} {{ image_width_1x }}w,
                  {{ fallback_image | image_url: width: image_width_1_5x }} {{ image_width_1_5x }}w,
                  {{ fallback_image | image_url: width: image_width_2x }} {{ image_width_2x }}w
                "
                sizes="min(100vw, {{ image_width_1x }}px)"
                alt="{{ fallback_image.alt | escape }}"
                class="prep-steps__image"
                loading="{{ img_loading }}"
                fetchpriority="{{ img_fetchpriority }}"
                decoding="async"
                width="{{ fallback_image.width }}"
                height="{{ fallback_image.height }}"
              >
            </picture>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="prep-steps__stats">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div
                  class="prep-steps__stat{% if block.settings.icon != blank %} prep-steps__stat--icon{% else %} prep-steps__stat--text{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.icon != blank -%}
                    <span class="prep-steps__stat-icon">
                      {{
                        block.settings.icon
                        | image_url: width: 160
                        | image_tag: loading: 'lazy', width: 64, height: 64, alt: block.settings.icon.alt, decoding: 'async'
                      }}
                    </span>
                  {%- else -%}
                    {%- if block.settings.value != blank -%}
                      <span class="prep-steps__stat-value">{{ block.settings.value | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.label != blank -%}
                      <span class="prep-steps__stat-label">{{ block.settings.label | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prep steps banner",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How to prepare it"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A clear, refreshing shake in 30 seconds."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>No blender. No clumps. Just cold water, one scoop and a shaker — then a short rest while the foam settles.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image when not set."
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Image width",
      "default": 420
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Sets the default background and text colors. Use the overrides below to fine-tune individual elements.",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Main background color"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle text color"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "info": "The bold value, e.g. \"300–400ml\"."
    },
    {
      "type": "color",
      "id": "card_description_color",
      "label": "Card description color",
      "info": "The label underneath, e.g. \"cold water\"."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. Shown above the value."
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "300–400ml"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "cold water"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prep steps banner",
      "category": "Custom",
      "blocks": [
        { "type": "stat", "settings": { "value": "300–400ml", "label": "cold water" } },
        { "type": "stat", "settings": { "value": "1 scoop", "label": "level 33g" } },
        { "type": "stat", "settings": { "value": "30–40s", "label": "shake" } },
        { "type": "stat", "settings": { "value": "30–60s", "label": "rest" } }
      ]
    }
  ]
}
{% endschema %}
