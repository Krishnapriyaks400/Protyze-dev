{%- liquid
  assign fallback_image = section.settings.image | default: section.settings.image_mobile
  assign image_width_1x = section.settings.image_width | default: 380
  assign image_width_2x = image_width_1x | times: 2
-%}
{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .text-image-banner-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      --tib-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.eyebrow_color != blank -%}
      --tib-eyebrow-color: {{ section.settings.eyebrow_color }};
    {%- endif -%}
    {%- if section.settings.heading_color != blank -%}
      --tib-heading-color: {{ section.settings.heading_color }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --tib-text-color: {{ section.settings.text_color }};
    {%- endif -%}
    {%- if section.settings.button_primary_bg != blank -%}
      --tib-btn-primary-bg: {{ section.settings.button_primary_bg }};
    {%- endif -%}
    {%- if section.settings.button_primary_text != blank -%}
      --tib-btn-primary-text: {{ section.settings.button_primary_text }};
    {%- endif -%}
    {%- if section.settings.button_secondary_bg != blank -%}
      --tib-btn-secondary-bg: {{ section.settings.button_secondary_bg }};
    {%- endif -%}
    {%- if section.settings.button_secondary_border != blank -%}
      --tib-btn-secondary-border: {{ section.settings.button_secondary_border }};
    {%- endif -%}
    {%- if section.settings.button_secondary_text != blank -%}
      --tib-btn-secondary-text: {{ section.settings.button_secondary_text }};
    {%- endif -%}
    {%- if section.settings.badge_color != blank -%}
      --tib-badge-color: {{ section.settings.badge_color }};
    {%- endif -%}
    {%- if section.settings.badge_caption_color != blank -%}
      --tib-badge-caption-color: {{ section.settings.badge_caption_color }};
    {%- endif -%}
    --tib-content-max-width: {{ section.settings.content_max_width | default: 480 }}px;
    --tib-image-width: {{ section.settings.image_width | default: 380 }}px;
  }

  .text-image-banner__wrapper {
    background-color: var(--tib-bg, rgb(var(--color-background)));
  }

  .text-image-banner__grid {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__grid {
      gap: 3rem;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    }
  }

  .text-image-banner__content {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin: 0 auto;
    max-width: var(--tib-content-max-width, 480px);
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__content {
      align-items: flex-start;
      margin: 0;
      text-align: left;
    }
  }

  .text-image-banner__eyebrow {
    color: var(--tib-eyebrow-color, rgb(var(--color-foreground)));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    margin: 0;
    text-transform: uppercase;
  }

  .text-image-banner__heading {
    color: var(--tib-heading-color, rgb(var(--color-foreground)));
    margin: 0;
    text-transform: none;
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      {%- if block.settings.heading_font_size_mobile > 0 -%}
        #TextImageBannerHeading-{{ section.id }} {
          font-size: {{ block.settings.heading_font_size_mobile }}px;
        }
      {%- endif -%}
      {%- if block.settings.heading_font_size_desktop > 0 -%}
        @media screen and (min-width: 750px) {
          #TextImageBannerHeading-{{ section.id }} {
            font-size: {{ block.settings.heading_font_size_desktop }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  .text-image-banner__text {
    color: var(--tib-text-color, rgba(var(--color-foreground), 0.75));
    margin: 0;
    max-width: 50rem;
  }

  .text-image-banner__buttons {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    margin-top: 0.8rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__buttons {
      width: auto;
    }
  }

  .text-image-banner__button {
    align-items: center;
    border-radius: 0.8rem;
    display: inline-flex;
    flex: 1 1 0;
    font-size: 1.2rem;
    font-weight: 700;
    justify-content: center;
    min-width: 0;
    padding: 1rem 1.2rem;
    text-decoration: none;
    transition: opacity var(--duration-short, 0.1s) ease;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__button {
      flex: 0 0 auto;
      font-size: 1.6rem;
      padding: 1.4rem 2.4rem;
    }
  }

  .text-image-banner__button:hover {
    opacity: 0.85;
  }

  .text-image-banner__button--primary {
    background-color: var(--tib-btn-primary-bg, rgb(var(--color-button)));
    border: 0.1rem solid var(--tib-btn-primary-bg, rgb(var(--color-button)));
    color: var(--tib-btn-primary-text, rgb(var(--color-button-text)));
  }

  .text-image-banner__button--secondary {
    background-color: var(--tib-btn-secondary-bg, transparent);
    border: 0.1rem solid var(--tib-btn-secondary-border, rgb(var(--color-foreground)));
    color: var(--tib-btn-secondary-text, rgb(var(--color-foreground)));
  }

  .text-image-banner__media {
    display: flex;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__media {
      justify-content: center;
    }
  }

  .text-image-banner__image {
    display: block;
    height: auto;
    max-width: 100%;
    width: min(100%, var(--tib-image-width, 380px));
  }

  .text-image-banner__badge-row {
    align-items: center;
    display: flex;
    gap: 1.2rem;
  }

  .text-image-banner__badge {
    align-items: center;
    border: 0.15rem solid var(--tib-badge-color, rgb(var(--color-foreground)));
    border-radius: 50% / 45%;
    color: var(--tib-badge-color, rgb(var(--color-foreground)));
    display: flex;
    flex-shrink: 0;
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 700;
    height: 4.2rem;
    justify-content: center;
    transform: rotate(-4deg);
    width: 6.2rem;
  }

  .text-image-banner__badge-caption {
    color: var(--tib-badge-caption-color, rgba(var(--color-foreground), 0.7));
    font-size: 1.3rem;
    margin: 0;
    text-align: left;
  }

  .text-image-banner__media--placeholder svg {
    height: auto;
    width: min(100%, var(--tib-image-width, 380px));
  }

  .text-image-banner__media--hide-mobile {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .text-image-banner__media--hide-mobile {
      display: flex;
    }
  }
{% endstyle %}

<div class="text-image-banner-{{ section.id }} color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="text-image-banner__wrapper">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="text-image-banner__grid">
        <div class="text-image-banner__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  <p class="text-image-banner__eyebrow" {{ block.shopify_attributes }}>
                    {{- block.settings.text | escape -}}
                  </p>
                {%- endif -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <h1
                    id="TextImageBannerHeading-{{ section.id }}"
                    class="text-image-banner__heading {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                    {%- if block.settings.heading_line_2 != blank -%}
                      <br>{{ block.settings.heading_line_2 }}
                    {%- endif -%}
                  </h1>
                {%- endif -%}
              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="text-image-banner__text rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              {%- when 'badge' -%}
                {%- if block.settings.badge_text != blank or block.settings.badge_caption != blank -%}
                  <div class="text-image-banner__badge-row" {{ block.shopify_attributes }}>
                    {%- if block.settings.badge_text != blank -%}
                      <span class="text-image-banner__badge">{{ block.settings.badge_text | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.badge_caption != blank -%}
                      <p class="text-image-banner__badge-caption">{{ block.settings.badge_caption | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- when 'buttons' -%}
                <div class="text-image-banner__buttons" {{ block.shopify_attributes }}>
                  {%- if block.settings.button_label_1 != blank -%}
                    <a
                      {% if block.settings.button_link_1 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link_1 }}"
                      {% endif %}
                      class="text-image-banner__button text-image-banner__button--primary"
                    >
                      {{- block.settings.button_label_1 | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      {% if block.settings.button_link_2 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link_2 }}"
                      {% endif %}
                      class="text-image-banner__button text-image-banner__button--secondary"
                    >
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="text-image-banner__media{% if section.settings.hide_image_on_mobile %} text-image-banner__media--hide-mobile{% endif %}">
          {%- if fallback_image != blank -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: image_width_1x }} 1x, {{ section.settings.image_mobile | image_url: width: image_width_2x }} 2x"
                >
              {%- endif -%}
              {%- if section.settings.image != blank -%}
                <source
                  media="(min-width: 750px)"
                  srcset="{{ section.settings.image | image_url: width: image_width_1x }} 1x, {{ section.settings.image | image_url: width: image_width_2x }} 2x"
                >
              {%- endif -%}
              <img
                src="{{ fallback_image | image_url: width: image_width_1x }}"
                srcset="{{ fallback_image | image_url: width: image_width_1x }} 1x, {{ fallback_image | image_url: width: image_width_2x }} 2x"
                alt="{{ fallback_image.alt | escape }}"
                class="text-image-banner__image"
                loading="lazy"
                width="{{ fallback_image.width }}"
                height="{{ fallback_image.height }}"
              >
            </picture>
          {%- else -%}
            <div class="text-image-banner__media--placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% javascript %}
  if (!window.__textImageBannerScrollBound) {
    window.__textImageBannerScrollBound = true;
    document.addEventListener('click', function (event) {
      const trigger = event.target.closest('.text-image-banner__button');
      if (!trigger) return;

      const href = trigger.getAttribute('href') || '';
      if (href.charAt(0) !== '#' || href.length < 2) return;

      const target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      const headerHeight =
        parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height'), 10) || 0;
      const top = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - 16;

      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Text with image banner",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Text column max width (desktop)",
      "default": 480
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image when not set."
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Image width",
      "info": "The image scales to fit this width and is never cropped.",
      "default": 380
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_mobile",
      "label": "Hide image on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Sets the default background and text colors. Use the overrides below to fine-tune individual elements.",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color override"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow text color override"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color override"
    },
    {
      "type": "header",
      "content": "Button colors"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Primary button background"
    },
    {
      "type": "color",
      "id": "button_primary_text",
      "label": "Primary button text"
    },
    {
      "type": "color",
      "id": "button_secondary_bg",
      "label": "Secondary button background",
      "info": "Leave blank for a transparent (outline-only) button."
    },
    {
      "type": "color",
      "id": "button_secondary_border",
      "label": "Secondary button outline"
    },
    {
      "type": "color",
      "id": "button_secondary_text",
      "label": "Secondary button text"
    },
    {
      "type": "header",
      "content": "Badge colors"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge outline / text color"
    },
    {
      "type": "color",
      "id": "badge_caption_color",
      "label": "Badge caption color"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "CLEAR WHEY VS REGULAR WHEY"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading — line 1",
          "default": "Same protein."
        },
        {
          "type": "inline_richtext",
          "id": "heading_line_2",
          "label": "Heading — line 2 (optional)",
          "info": "Rendered on its own line below line 1.",
          "default": "A completely different drink."
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ],
          "default": "h0",
          "label": "Heading size",
          "info": "Used unless a custom font size below is set. Already responsive: smaller on mobile, larger on desktop automatically."
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Custom font size — mobile",
          "info": "Leave at 0 to use the heading size above."
        },
        {
          "type": "range",
          "id": "heading_font_size_desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0,
          "label": "Custom font size — desktop",
          "info": "Leave at 0 to use the heading size above."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Both give you whey protein. One mixes thick and creamy like a milkshake; the other mixes crystal-clear with water and drinks like a fruit squash.</p>"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge + text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "e.g. \"2020\" — shown in a circled badge.",
          "default": "2020"
        },
        {
          "type": "text",
          "id": "badge_caption",
          "label": "Line of text",
          "info": "Optional. Line of text next to the badge.",
          "default": "It all started with one simple question."
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "First button label",
          "default": "Shop Clear Whey"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "First button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Second button label",
          "default": "See the comparison"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link",
          "info": "To scroll to another section on this page instead of linking elsewhere, use that section's ID, e.g. #shopify-section-template--123456789__comparison_table (find it in the theme editor's page source or the section's block ID)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text with image banner",
      "category": "Custom",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
