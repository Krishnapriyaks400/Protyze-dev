{%- liquid
  assign oq_img = section.settings.image | default: section.settings.image_mobile
  assign oq_mob = section.settings.image_mobile
  assign oq_has_mob_source = false
  if section.settings.image != blank and oq_mob != blank
    assign oq_has_mob_source = true
  endif

  assign oq_mob_ratio = 1.3333
  if oq_mob != blank
    assign oq_mob_ratio = oq_mob.aspect_ratio
  endif
-%}

{%- style -%}
  .oq-{{ section.id }} {
    --oq-bg: {{ section.settings.background_color | default: '#f7f5f0' }};
    --oq-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --oq-accent: {{ section.settings.accent_color | default: '#e8541e' }};
    --oq-fade: {{ section.settings.fade_width }}%;
    background-color: var(--oq-bg);
    color: var(--oq-text);
    overflow: hidden;
  }

  .oq-{{ section.id }} .oq__grid {
    display: grid;
    gap: 2.8rem;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: 3.6rem;
    padding-top: 3.6rem;
  }

  /* Each column is a vertical stack of blocks. Mobile centres everything. */
  .oq-{{ section.id }} .oq__col {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: center;
  }

  .oq-{{ section.id }} .oq__col > * {
    margin: 0;
  }

  .oq-{{ section.id }} .oq__eyebrow {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .oq-{{ section.id }} .oq__heading {
    color: var(--oq-text);
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 1.9rem + 1.4vw, 3.4rem);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
    line-height: 1.12;
    text-transform: none;
  }

  .oq-{{ section.id }} .oq__body {
    font-size: 1.4rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .oq-{{ section.id }} .oq__body--bold {
    font-weight: 700;
    opacity: 1;
  }

  .oq-{{ section.id }} .oq__steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    text-align: left;
  }

  .oq-{{ section.id }} .oq__step {
    align-items: flex-start;
    display: flex;
    font-size: 1.4rem;
    gap: 1rem;
    line-height: 1.4;
  }

  .oq-{{ section.id }} .oq__step-num {
    align-items: center;
    border: 0.12rem solid currentColor;
    border-radius: 50%;
    display: inline-flex;
    flex-shrink: 0;
    font-size: 1.1rem;
    height: 2.2rem;
    justify-content: center;
    width: 2.2rem;
  }

  .oq-{{ section.id }} .oq__aside {
    align-items: center;
    display: flex;
    gap: 1.4rem;
    justify-content: center;
    text-align: left;
  }

  .oq-{{ section.id }} .oq__icon {
    flex-shrink: 0;
    height: auto;
    width: 5.6rem;
  }

  .oq-{{ section.id }} .oq__aside-text,
  .oq-{{ section.id }} .oq__highlight-sub {
    font-size: 1.4rem;
    line-height: 1.45;
    margin: 0;
    opacity: 0.85;
  }

  .oq-{{ section.id }} .oq__highlight {
    color: var(--oq-accent);
    font-size: 1.8rem;
    font-style: italic;
    line-height: 1.3;
    margin: 0.6rem 0 0;
  }

  .oq-{{ section.id }} .oq__highlight-sub {
    margin-top: 0.4rem;
  }

  .oq-{{ section.id }} .oq__hand-img {
    display: block;
    height: auto;
    max-width: 100%;
    width: calc(var(--oq-w, 240px) * 0.85);
  }

  .oq-{{ section.id }} .oq__hand-img--inline {
    margin-top: 0.6rem;
  }

  /* Typed fallback for handwritten blocks when no image is uploaded. */
  .oq-{{ section.id }} .oq__hand-text {
    color: var(--oq-accent);
    font-size: 2.6rem;
    font-style: italic;
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
  }

  .oq-{{ section.id }} .oq__question-title {
    display: inline-block;
    font-size: 2.4rem;
    font-style: italic;
    line-height: 1.2;
  }

  .oq-{{ section.id }} .oq__underline {
    color: var(--oq-text);
    display: block;
    height: 1rem;
    margin-top: 0.4rem;
    width: 100%;
  }

  .oq-{{ section.id }} .oq__quote {
    font-size: clamp(2.4rem, 1.8rem + 1.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .oq-{{ section.id }} .oq__quote-mark {
    color: var(--oq-accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.6em;
    font-weight: 700;
    line-height: 0;
    position: relative;
    top: 0.35em;
  }

  .oq-{{ section.id }} .oq__quote-mark--open {
    margin-right: 0.1em;
  }

  .oq-{{ section.id }} .oq__quote-mark--close {
    margin-left: 0.1em;
  }

  .oq-{{ section.id }} .oq__arrow {
    color: var(--oq-text);
    display: block;
    width: calc(var(--oq-w, 80px) * 0.8);
  }

  .oq-{{ section.id }} .oq__arrow svg,
  .oq-{{ section.id }} .oq__arrow img {
    display: block;
    height: auto;
    width: 100%;
  }

  .oq-{{ section.id }} .oq__arrow--down-left svg { transform: scaleX(-1); }
  .oq-{{ section.id }} .oq__arrow--up-right svg { transform: scaleY(-1); }
  .oq-{{ section.id }} .oq__arrow--up-left svg { transform: scale(-1, -1); }
  .oq-{{ section.id }} .oq__arrow--right svg { transform: rotate(-40deg); }

  .oq-{{ section.id }} .oq__media {
    aspect-ratio: {{ oq_mob_ratio }};
    border-radius: 8px;
    overflow: hidden;
  }

  .oq-{{ section.id }} .oq__media img {
    display: block;
    height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    object-position: {{ section.settings.image_focus }};
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .oq-{{ section.id }} .oq__arrow--desktop-only {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .oq-{{ section.id }} .oq__grid {
      align-items: stretch;
      gap: 0;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 0.95fr);
      min-height: {{ section.settings.desktop_height }}px;
      padding-bottom: 0;
      padding-top: 0;
    }

    .oq-{{ section.id }} .oq__col {
      align-items: flex-start;
      align-self: center;
      padding: 4rem 0;
      position: relative;
      text-align: left;
      z-index: 1;
    }

    .oq-{{ section.id }} .oq__col--right {
      padding-left: 2.4rem;
    }

    .oq-{{ section.id }} .oq__aside {
      justify-content: flex-start;
    }

    .oq-{{ section.id }} .oq__hand-img {
      width: var(--oq-w, 240px);
    }

    .oq-{{ section.id }} .oq__arrow {
      width: var(--oq-w, 80px);
    }

    .oq-{{ section.id }} .oq__question-title {
      font-size: 2.8rem;
    }

    {%- if section.settings.fade_width > 0 %}
      /* The image bleeds past its column and fades into the background on both
         sides, so the photo blends into the text panels. */
      .oq-{{ section.id }} .oq__media {
        aspect-ratio: auto;
        border-radius: 0;
        margin: 0 -6rem;
        -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 var(--oq-fade), #000 calc(100% - var(--oq-fade)), transparent 100%);
        mask-image: linear-gradient(90deg, transparent 0%, #000 var(--oq-fade), #000 calc(100% - var(--oq-fade)), transparent 100%);
        position: relative;
      }
    {%- else %}
      /* No fade: the image stays inside its own column with a gap either side. */
      .oq-{{ section.id }} .oq__media {
        aspect-ratio: auto;
        margin: 2.4rem 3.2rem;
        position: relative;
      }
    {%- endif %}

    .oq-{{ section.id }} .oq__media img,
    .oq-{{ section.id }} .oq__media picture {
      height: 100%;
      inset: 0;
      position: absolute;
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="oq-{{ section.id }}">
  <div class="page-width oq__grid">
    <div class="oq__col oq__col--left">
      {%- for block in section.blocks -%}
        {%- if block.settings.column != 'right' -%}
          {%- render 'origin-question-block', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if oq_img != blank -%}
      <div class="oq__media">
        <picture>
          {%- if oq_has_mob_source -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ oq_mob | image_url: width: 500 }} 500w, {{ oq_mob | image_url: width: 750 }} 750w, {{ oq_mob | image_url: width: 1080 }} 1080w"
              sizes="100vw"
              width="{{ oq_mob.width }}"
              height="{{ oq_mob.height }}"
            >
          {%- endif -%}
          {{
            oq_img
            | image_url: width: 1800
            | image_tag: widths: '500, 750, 1000, 1400, 1800', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy'
          }}
        </picture>
      </div>
    {%- endif -%}

    <div class="oq__col oq__col--right">
      {%- for block in section.blocks -%}
        {%- if block.settings.column == 'right' -%}
          {%- render 'origin-question-block', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

