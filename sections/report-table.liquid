          "label": "t:sections.report-table.settings.header.header__2.label"
        },
        {
          "type": "text",
          "id": "th3",
          "label": "t:sections.report-table.settings.header.header__3.label"
        },
        {
          "type": "text",
          "id": "th4",
          "label": "t:sections.report-table.settings.header.header__4.label"
        },
        {
        "type": "color",
