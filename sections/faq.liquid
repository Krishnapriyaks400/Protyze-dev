{{ 'faq.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  On collection pages, prefer the collection.metafields.custom.faqs list metafield
  (list of FAQ metaobjects with "question"/"answer" fields) over editor blocks.
  Its FAQPage JSON-LD is already emitted by snippets/collection-schema.liquid
  (rendered from main-collection-product-grid.liquid), so this section skips its
  own schema output in that case to avoid a duplicate FAQPage script.
  On all other templates it falls back to the original block-based content.
{%- endcomment -%}
{%- assign _metafield_faqs = collection.metafields.custom.faqs.value -%}
{%- assign _use_metafield = false -%}
{%- if collection != blank and _metafield_faqs != blank -%}
  {%- assign _use_metafield = true -%}
{%- endif -%}

{%- if _use_metafield or section.blocks.size > 0 -%}

  {%- unless _use_metafield -%}
  {%- comment -%}── FAQPage JSON-LD schema (blocks) ──────────────────────────────{%- endcomment -%}
  {%- assign _has_faq = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.question != blank and block.settings.answer != blank -%}
      {%- assign _has_faq = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if _has_faq -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign _first_item = true -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- unless _first_item -%},{%- endunless -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }
          {%- assign _first_item = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
  {%- endif -%}
  {%- endunless -%}

  <section
    class="faq color-{{ section.settings.color_scheme }}"
    id="faq-{{ section.id }}"
    style="
      --faq-accent: {{ section.settings.accent_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width faq__wrapper">

      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="faq__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="faq__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="faq__list" id="FaqList-{{ section.id }}">
        {%- if _use_metafield -%}
          {%- for faq in _metafield_faqs -%}
            {%- if faq.question != blank -%}
              <details
                class="faq__item"
                {%- if section.settings.open_first and forloop.first %} open{%- endif -%}
              >
                <summary class="faq__question" aria-label="{{ faq.question | escape }}">
                  <span class="faq__question-text">{{ faq.question | escape }}</span>
                  <span class="faq__icon" aria-hidden="true">
                    <span class="faq__icon--plus">+</span>
                    <span class="faq__icon--close">&times;</span>
                  </span>
                </summary>
                {%- if faq.answer != blank -%}
                  <div class="faq__answer">
                    {{ faq.answer }}
                  </div>
                {%- endif -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank -%}
              <details
                class="faq__item"
                {{ block.shopify_attributes }}
                {%- if section.settings.open_first and forloop.first %} open{%- endif -%}
                {%- if block.settings.card_bg_color != blank and block.settings.card_bg_color != 'rgba(0,0,0,0)' %}
                  style="background: {{ block.settings.card_bg_color }};"
                {%- endif -%}
              >
                <summary class="faq__question" aria-label="{{ block.settings.question | escape }}">
                  <span class="faq__question-text">{{ block.settings.question | escape }}</span>
                  <span class="faq__icon" aria-hidden="true">
                    <span class="faq__icon--plus">+</span>
                    <span class="faq__icon--close">&times;</span>
                  </span>
                </summary>
                {%- if block.settings.answer != blank -%}
                  <div class="faq__answer">
                    {{ block.settings.answer }}
                  </div>
                {%- endif -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

    </div>
  </section>

  {%- if section.settings.exclusive_mode -%}
  <script>
    (function () {
      var list = document.getElementById('FaqList-{{ section.id }}');
      if (!list) return;
      list.addEventListener('click', function (e) {
        var summary = e.target.closest('summary');
        if (!summary) return;
        var openItems = list.querySelectorAll('details[open]');
        openItems.forEach(function (d) {
          if (d !== summary.parentElement) d.removeAttribute('open');
        });
      });
    })();
  </script>
  {%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "GOOD TO KNOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for eyebrow, +/× icons, and open border highlight",
      "default": "#e91e63"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "exclusive_mode",
      "label": "Close others when one opens",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write your answer here. You can use <strong>bold text</strong> and links.</p>"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is this whey protein isolate or concentrate?",
            "answer": "<p>Anytime Clear Whey is made using whey protein isolate, offering high protein purity with minimal lactose and fats.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is clear whey easier to digest than regular whey?",
            "answer": "<p>Yes, clear whey isolate is lighter on the stomach and digests faster than traditional whey concentrate.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I drink this protein daily?",
            "answer": "<p>Absolutely. It is safe for daily consumption as part of a balanced diet and training routine.</p>"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}
