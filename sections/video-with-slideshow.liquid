<!-- section layout -->
<div class="split-layout-section">
  <div class="split-layout-wrapper {{ section.settings.media_position }}">

    {% if section.settings.media_position == 'left' %}
      <div class="media-container">
        {% if section.settings.enable_video and section.settings.video != blank %}
          <video autoplay muted loop playsinline class="media-video">
            <source src="{{ section.settings.video }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="Split Image"
            width="600"
            height="800"
            loading="lazy"
            class="media-image">
        {% endif %}
      </div>
    {% endif %}

    <div class="slider-container">
    <div class="swiper slideshow-swiper">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
            <div class="swiper-slide">
                {% if block.settings.slide_image != blank %}
                <img src="{{ block.settings.slide_image | image_url: width: 1200 }}"
                    alt="Slide Image"
                    width="100%"
                    height="100%"
                    loading="lazy">
                {% endif %}
                <div class="slide-text">
                <h2>{{ block.settings.heading }}</h2>
                <p>{{ block.settings.subheading }}</p>
                {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" class="slide-button">{{ block.settings.button_text }}</a>
                {% endif %}
                </div>
            </div>
            {% endfor %}
           
        </div>
        <div class="swiper-pagination"></div>
        </div>
    </div>

    {% if section.settings.media_position == 'right' %}
      <div class="media-container">
        {% if section.settings.enable_video and section.settings.video != blank %}
          <video autoplay muted loop playsinline class="media-video">
            <source src="{{ section.settings.video }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="Split Image"
            width="600"
            height="800"
            loading="lazy"
            class="media-image">
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>

<!-- section styles -->
<style>
.split-layout-section {
  width: 100%;
  padding: 0;
}
.split-layout-wrapper {
  display: flex;
  flex-direction: row;
  width: 100%;
}
.split-layout-wrapper.right {
  flex-direction: row-reverse;
}

.media-container,
.slider-container {
  width: 50%;
  overflow: hidden;
}
.media-image,
.media-video {
  width: 100%;
  height: auto;
  object-fit: cover;
}
.swiper-slide {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  text-align: center;
}
.slide-text {
  background: rgba(255,255,255,0.8);
  padding: 1rem;
  border-radius: 1rem;
  max-width: 80%;
  margin-top: 1rem;
}
.slide-button {
  background-color: black;
  color: white;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  margin-top: 1rem;
  display: inline-block;
}
.slider-container .swiper img {
  border-radius: 0;
}

.slide-text{
    display: none;
}
.split-layout-section .swiper-pagination {
bottom: 0px;
}
.split-layout-section .swiper-pagination .swiper-pagination-bullet-active {
background: #000000;
}
.split-layout-section .swiper{
padding-bottom: 0px;
}
@media screen and (max-width: 768px) {
  .split-layout-wrapper {
    flex-direction: column-reverse;
  }
  .media-container,
  .slider-container {
    width: 100%;
    display: flex;
  }
}
</style>


<!-- Swiper Init -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.slideshow-swiper', {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      }
    });
  });
</script>


{% schema %}
{
  "name": "Split Layout Slider",
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "Media Position",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "right", "label": "Right"}
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "enable_video",
      "label": "Enable Video",
      "default": false
    },
   {
      "type": "url",
      "id": "video",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Static Image (for split layout)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Split Layout Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}

