{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .badge-text-card-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      --btc-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.card_background_color != blank -%}
      --btc-card-bg: {{ section.settings.card_background_color }};
    {%- endif -%}
    {%- if section.settings.text_color != blank -%}
      --btc-text-color: {{ section.settings.text_color }};
    {%- endif -%}
    {%- if section.settings.badge_background_color != blank -%}
      --btc-badge-bg: {{ section.settings.badge_background_color }};
    {%- endif -%}
    {%- if section.settings.badge_text_color != blank -%}
      --btc-badge-text: {{ section.settings.badge_text_color }};
    {%- endif -%}
    {%- if section.settings.button_background_color != blank -%}
      --btc-btn-bg: {{ section.settings.button_background_color }};
    {%- endif -%}
    {%- if section.settings.button_text_color != blank -%}
      --btc-btn-text: {{ section.settings.button_text_color }};
    {%- endif -%}
    --btc-card-max-width: {{ section.settings.card_max_width | default: 900 }}px;
  }

  .badge-text-card__wrapper {
    background-color: var(--btc-bg, rgb(var(--color-background)));
  }

  .badge-text-card__card {
    align-items: center;
    background-color: var(--btc-card-bg, rgb(var(--color-background)));
    border-radius: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--btc-card-max-width, 900px);
    padding: 3.2rem;
  }

  @media screen and (max-width: 749px) {
    .badge-text-card__card {
      padding: 2.4rem 2rem;
    }
  }

  .badge-text-card__content {
    flex: 1 1 26rem;
  }

  .badge-text-card__action {
    flex: 0 0 auto;
  }

  .badge-text-card__heading {
    color: var(--btc-text-color, rgb(var(--color-foreground)));
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 1.2rem;
    text-transform: none;
  }

  @media screen and (min-width: 750px) {
    .badge-text-card__heading {
      font-size: 2.8rem;
    }
  }

  .badge-text-card__button {
    background-color: var(--btc-btn-bg, rgb(var(--color-button)));
    border: 0.1rem solid var(--btc-btn-bg, rgb(var(--color-button)));
    border-radius: 0.8rem;
    color: var(--btc-btn-text, rgb(var(--color-button-text)));
    display: inline-flex;
    font-size: 1.5rem;
    font-weight: 700;
    padding: 1.4rem 2.4rem;
    text-decoration: none;
    transition: opacity var(--duration-short, 0.1s) ease;
    white-space: nowrap;
  }

  .badge-text-card__button:hover {
    opacity: 0.85;
  }

  .badge-text-card__badge {
    background-color: var(--btc-badge-bg, rgba(var(--color-foreground), 0.06));
    border-radius: 0.8rem;
    color: var(--btc-badge-text, rgb(var(--color-foreground)));
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    margin: 0 0 2rem;
    padding: 0.8rem 1.6rem;
    text-transform: none;
  }

  .badge-text-card__text {
    color: var(--btc-text-color, rgb(var(--color-foreground)));
  }

  .badge-text-card__text p {
    margin: 0 0 1.6rem;
  }

  .badge-text-card__text p:last-child {
    margin-bottom: 0;
  }
{% endstyle %}

<div class="badge-text-card-{{ section.id }} color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="badge-text-card__wrapper">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="badge-text-card__card">
        <div class="badge-text-card__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'badge' -%}
                {%- if block.settings.text != blank -%}
                  <span class="badge-text-card__badge" {{ block.shopify_attributes }}>
                    {{- block.settings.text | escape -}}
                  </span>
                {%- endif -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="badge-text-card__heading" {{ block.shopify_attributes }}>
                    {{- block.settings.heading | escape -}}
                  </h3>
                {%- endif -%}
              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="badge-text-card__text rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and block.settings.button_label != blank -%}
            <div class="badge-text-card__action" {{ block.shopify_attributes }}>
              <a
                {% if block.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="badge-text-card__button"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Badge text card",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Card max width",
      "info": "Default matches the Comparison table section's card width (900px).",
      "default": 900
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Sets the default background and text colors. Use the overrides below to fine-tune individual elements.",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Main background color"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Badge colors"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background color"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color"
    },
    {
      "type": "header",
      "content": "Button colors"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "The short answer"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Try it for yourself"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p><strong>Regular whey</strong> (concentrate or blends) keeps more fat and lactose and uses gums or creamers to build a thick, filling, dessert-style shake — usually with milk or water.</p><p><strong>Clear whey isolate</strong> is filtered further to strip out almost all fat, lactose and carbs, with no gums or thickeners. It dissolves clear in water for a light, fruit-flavoured drink that's easier to have every single day.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Clear Whey"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Badge text card",
      "category": "Custom",
      "blocks": [
        { "type": "badge" },
        { "type": "text" }
      ]
    },
    {
      "name": "Heading, text and button card",
      "category": "Custom",
      "blocks": [
        { "type": "heading" },
        {
          "type": "text",
          "settings": {
            "text": "<p>Eight fruit-inspired flavours,<br>24g of whey isolate per serving,<br>and a 30-day money-back guarantee.</p>"
          }
        },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
