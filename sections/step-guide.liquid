{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .step-guide-{{ section.id }} {
    {%- if section.settings.background_color != blank -%}
      --sg-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.caption_color != blank -%}
      --sg-caption-color: {{ section.settings.caption_color }};
    {%- endif -%}
    {%- if section.settings.tip_background_color != blank -%}
      --sg-tip-bg: {{ section.settings.tip_background_color }};
    {%- endif -%}
    {%- if section.settings.tip_text_color != blank -%}
      --sg-tip-text: {{ section.settings.tip_text_color }};
    {%- endif -%}
    {%- if section.settings.subtext_color != blank -%}
      --sg-subtext-color: {{ section.settings.subtext_color }};
    {%- endif -%}
    {%- if section.settings.card_background_color != blank -%}
      --sg-card-bg: {{ section.settings.card_background_color }};
      --sg-card-padding: 1.2rem;
    {%- endif -%}
  }

  .step-guide__wrapper {
    background-color: var(--sg-bg, rgb(var(--color-background)));
  }

  .step-guide__intro {
    margin: 0 auto 2.8rem;
    max-width: 70rem;
    text-align: center;
  }

  .step-guide__subtext {
    color: var(--sg-subtext-color, rgb(var(--color-foreground)));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.15rem;
    margin: 0 0 0.8rem;
    text-transform: uppercase;
  }

  .step-guide__heading {
    color: rgb(var(--color-foreground));
    margin: 0;
    text-align: center;
    text-transform: none;
  }

  .step-guide__intro-description {
    color: var(--sg-caption-color, rgba(var(--color-foreground), 0.7));
    margin: 1.6rem 0 0;
  }

  .step-guide__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 1.6rem;
    justify-content: center;
  }

  .step-guide__step {
    background-color: var(--sg-card-bg, transparent);
    border-radius: 0.8rem;
    flex: 0 1 calc(50% - 0.8rem);
    padding: var(--sg-card-padding, 0);
    position: relative;
  }

  .step-guide__step--link {
    color: inherit;
    display: block;
    text-decoration: none;
    transition: opacity var(--duration-short, 0.1s) ease;
  }

  .step-guide__step--link:hover {
    opacity: 0.85;
  }

  @media screen and (min-width: 750px) {
    .step-guide__grid {
      flex-wrap: wrap;
      gap: 2.4rem;
      justify-content: center;
      margin: 0 auto;
      max-width: 109.6rem;
    }

    .step-guide__step {
      flex: 0 0 20rem;
      width: 20rem;
    }
  }

  .step-guide__image-wrap {
    aspect-ratio: 1 / 1;
    background-color: rgba(var(--color-foreground), 0.04);
    border-radius: 0.8rem;
    overflow: hidden;
    position: relative;
  }

  .step-guide__image {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .step-guide__caption {
    color: var(--sg-caption-color, rgb(var(--color-foreground)));
    font-size: 1.2rem;
    margin: 1.2rem 0 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .step-guide__caption {
      font-size: 1.4rem;
    }
  }

  .step-guide__caption p {
    margin: 0;
  }

  .step-guide__tip {
    align-items: flex-start;
    background-color: var(--sg-tip-bg, #ff4b2b);
    border-radius: 0.8rem;
    color: var(--sg-tip-text, #fff);
    display: flex;
    gap: 1.2rem;
    margin-top: 2rem;
    padding: 1.6rem 2rem;
  }

  @media screen and (min-width: 750px) {
    .step-guide__tip {
      margin-top: 3.2rem;
    }
  }

  .step-guide__tip-icon {
    flex-shrink: 0;
    height: 2rem;
    width: 2rem;
  }

  .step-guide__tip-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  .step-guide__tip-text {
    font-size: 1.3rem;
    margin: 0;
    opacity: 0.95;
  }

  .step-guide__tip-text p {
    margin: 0;
  }
{% endstyle %}

<div class="step-guide-{{ section.id }} color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="step-guide__wrapper">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.subtext != blank or section.settings.heading != blank or section.settings.intro_description != blank -%}
        <div class="step-guide__intro">
          {%- if section.settings.subtext != blank -%}
            <p class="step-guide__subtext">{{ section.settings.subtext | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="step-guide__heading h1">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro_description != blank -%}
            <div class="step-guide__intro-description rte">{{ section.settings.intro_description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="step-guide__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- capture step_inner -%}
              <div class="step-guide__image-wrap">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'step-guide__image', alt: block.settings.image.alt, sizes: '(min-width: 750px) 33vw, 50vw', widths: '300, 450, 600, 800'
                  }}
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <div class="step-guide__caption rte">{{ block.settings.caption }}</div>
              {%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="step-guide__step step-guide__step--link"
                {{ block.shopify_attributes }}
              >
                {{ step_inner }}
              </a>
            {%- else -%}
              <div class="step-guide__step" {{ block.shopify_attributes }}>
                {{ step_inner }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.tip_text != blank -%}
        <div class="step-guide__tip">
          <svg class="step-guide__tip-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2L14.5 9H21.5L15.8 13.2L18 20L12 15.8L6 20L8.2 13.2L2.5 9H9.5L12 2Z" fill="currentColor"/>
          </svg>
          <div>
            {%- if section.settings.tip_title != blank -%}
              <p class="step-guide__tip-title">{{ section.settings.tip_title | escape }}</p>
            {%- endif -%}
            <div class="step-guide__tip-text rte">{{ section.settings.tip_text }}</div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Step guide",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (eyebrow)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Six steps to a clear, refreshing shake"
    },
    {
      "type": "richtext",
      "id": "intro_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Pro tip"
    },
    {
      "type": "text",
      "id": "tip_title",
      "label": "Tip title",
      "default": "Pro Tip"
    },
    {
      "type": "richtext",
      "id": "tip_text",
      "label": "Tip text",
      "default": "<p>For an even more refreshing experience, add ice cubes or chill your prepared drink in the refrigerator for 10–15 minutes before serving.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Sets the default background and text colors. Use the overrides below to fine-tune individual elements.",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Main background color"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext (eyebrow) color"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "info": "Optional. Adds a background and padding behind each step's image and caption."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption / description text color"
    },
    {
      "type": "color",
      "id": "tip_background_color",
      "label": "Pro tip background"
    },
    {
      "type": "color",
      "id": "tip_text_color",
      "label": "Pro tip text"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "caption",
          "label": "Caption",
          "default": "<p>Pour 300–400 ml <strong>cold water</strong> into a shaker.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the whole card clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Step guide",
      "category": "Custom",
      "blocks": [
        { "type": "step", "settings": { "caption": "<p>Pour 300–400 ml <strong>cold water</strong> into a shaker.</p>" } },
        { "type": "step", "settings": { "caption": "<p>Add 1 scoop of <strong>Protyze Clear Whey Protein</strong>.</p>" } },
        { "type": "step", "settings": { "caption": "<p><strong>Shake well</strong> for 30–40 seconds.</p>" } },
        { "type": "step", "settings": { "caption": "<p>Let it rest for <strong>30–60 seconds</strong> for the foam to settle.</p>" } },
        { "type": "step", "settings": { "caption": "<p><strong>Wait 5–10 minutes</strong> for the best taste.</p>" } },
        { "type": "step", "settings": { "caption": "<p>Let it rest for <strong>30–60 seconds</strong> for the foam to settle.</p>" } }
      ]
    }
  ]
}
{% endschema %}
