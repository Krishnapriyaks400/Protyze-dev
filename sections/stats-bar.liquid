{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .stats-bar-{{ section.id }} {
    --sbar-bg: {{ section.settings.background_color | default: '#151515' }};
    --sbar-number-color: {{ section.settings.number_color | default: '#ff6a2a' }};
    --sbar-label-color: {{ section.settings.label_color | default: '#e6e6e6' }};
    --sbar-divider-color: {{ section.settings.divider_color | default: 'rgba(255, 255, 255, 0.15)' }};
  }

  .stats-bar__wrapper {
    background-color: var(--sbar-bg);
  }

  .stats-bar__grid {
    display: grid;
    gap: 2rem 1.2rem;
    grid-template-columns: repeat(2, 1fr);
  }

  @media screen and (min-width: 750px) {
    .stats-bar__grid {
      align-items: center;
      display: flex;
      gap: 0;
      justify-content: space-between;
    }
  }

  .stats-bar__item {
    align-items: center;
    display: flex;
    gap: 1rem;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .stats-bar__item {
      flex: 0 1 auto;
      padding: 0 2rem;
    }

    .stats-bar__item:not(:last-child):after {
      background-color: var(--sbar-divider-color);
      content: '';
      height: 3.2rem;
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 0.1rem;
    }
  }

  .stats-bar__icon {
    flex-shrink: 0;
    height: 3.2rem;
    width: 3.2rem;
  }

  .stats-bar__icon img {
    display: block;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .stats-bar__text {
    display: flex;
    flex-direction: column;
  }

  .stats-bar__value {
    color: var(--sbar-number-color);
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .stats-bar__label {
    color: var(--sbar-label-color);
    font-size: 1.2rem;
    line-height: 1.3;
    white-space: nowrap;
  }
{% endstyle %}

<div class="stats-bar-{{ section.id }} color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
  <div class="stats-bar__wrapper">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="stats-bar__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="stats-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="stats-bar__icon">
                  {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                </span>
              {%- endif -%}
              <div class="stats-bar__text">
                {%- if block.settings.value != blank -%}
                  <span class="stats-bar__value">{{ block.settings.value | escape }}</span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="stats-bar__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Stats bar",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#ff6a2a"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color (desktop only)"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Recommended size: at least 100 x 100px, transparent PNG/SVG."
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "730+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Days of obsession"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats bar",
      "category": "Custom",
      "blocks": [
        { "type": "stat", "settings": { "value": "730+", "label": "Days of obsession" } },
        { "type": "stat", "settings": { "value": "1000+", "label": "Experiments" } },
        { "type": "stat", "settings": { "value": "50+", "label": "Failed Recipes" } },
        { "type": "stat", "settings": { "value": "1", "label": "Kitchen" } },
        { "type": "stat", "settings": { "value": "1", "label": "Mission" } },
        { "type": "stat", "settings": { "value": "Millions", "label": "Of servings today" } }
      ]
    }
  ]
}
{% endschema %}
