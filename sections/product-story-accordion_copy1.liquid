{{ 'product-story-accordion_copy1.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ps_accent = section.settings.accent_color
  if ps_accent == blank and product
    assign ps_accent = product.metafields.custom.flavour_color.value
  endif
  if ps_accent == blank
    assign ps_accent = '#e07b28'
  endif

  assign ps_tab_text = section.settings.tab_text_color | default: '#ffffff'
  assign ps_active_text = section.settings.active_text_color | default: '#111111'
-%}

{%- liquid
  assign ps_tab_r = ps_tab_text | color_extract: 'red'
  assign ps_tab_g = ps_tab_text | color_extract: 'green'
  assign ps_tab_b = ps_tab_text | color_extract: 'blue'
  assign ps_act_r = ps_active_text | color_extract: 'red'
  assign ps_act_g = ps_active_text | color_extract: 'green'
  assign ps_act_b = ps_active_text | color_extract: 'blue'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .ps-{{ section.id }} {
    --ps-accent: {{ ps_accent }};
    --ps-tab-bg: {{ section.settings.tab_bg_color | default: '#232428' }};
    --ps-tab-fg: {{ ps_tab_r }}, {{ ps_tab_g }}, {{ ps_tab_b }};
    --ps-active-bg: {{ section.settings.active_bg_color | default: '#e3f0d0' }};
    --ps-active-fg: {{ ps_act_r }}, {{ ps_act_g }}, {{ ps_act_b }};
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="ps-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="product-story page-width section-{{ section.id }}-padding">
    <div class="ps__layout">
      <div class="ps__nav">
        {%- if section.settings.caption != blank -%}
          <p class="ps__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ps__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div
          class="ps__tabs"
          role="tablist"
          aria-label="{{ section.settings.heading | strip_html | escape }}"
          id="PsTabs-{{ section.id }}"
        >
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="ps__tab"
              id="PsTab-{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="PsPanel-{{ block.id }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-block-id="{{ block.id }}"
              {% if block.settings.card_bg_color != blank %}
                style="--ps-item-bg: {{ block.settings.card_bg_color }};"
              {% endif %}
            >
              <span class="ps__tab-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="ps__tab-text">
                <span class="ps__tab-title">{{ block.settings.heading | escape }}</span>
                {%- if block.settings.subtitle != blank -%}
                  <span class="ps__tab-sub">{{ block.settings.subtitle | escape }}</span>
                {%- endif -%}
              </span>
              <svg class="ps__tab-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 12h16M14 6l6 6-6 6"/>
              </svg>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="ps__panels">
        {%- for block in section.blocks -%}
          {%- assign ps_panel_img = block.settings.panel_image | default: section.settings.side_image -%}
          <div
            class="ps__panel{% if ps_panel_img != blank %} ps__panel--has-media{% endif %}"
            id="PsPanel-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="PsTab-{{ block.id }}"
            tabindex="0"
            {% unless forloop.first %}
              hidden
            {% endunless %}
            {% if block.settings.card_bg_color != blank %}
              style="--ps-item-bg: {{ block.settings.card_bg_color }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="ps__panel-body">
              <h3 class="ps__panel-title">{{ block.settings.panel_title | default: block.settings.heading | escape }}</h3>
              {%- if block.settings.panel_lead != blank -%}
                <p class="ps__panel-lead">{{ block.settings.panel_lead | escape }}</p>
              {%- endif -%}

              <div class="product-story__content">
{%- case block.type -%}

                {%- when 'description' -%}
                  <div class="product-story__description rte">
                    {%- if block.settings.use_product_description -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.custom_description }}
                    {%- endif -%}
                  </div>

                {%- when 'benefits' -%}
                  <div class="product-story__benefits">
                    <div class="product-story__benefit-grid">
                      {%- for i in (1..6) -%}
                        {%- liquid
                          assign b_title_key = 'benefit_' | append: i | append: '_title'
                          assign b_desc_key = 'benefit_' | append: i | append: '_desc'
                          assign b_icon_key = 'benefit_' | append: i | append: '_icon'
                          assign b_color_key = 'benefit_' | append: i | append: '_color'
                          assign b_title = block.settings[b_title_key]
                          assign b_desc = block.settings[b_desc_key]
                          assign b_icon = block.settings[b_icon_key]
                          assign b_color = block.settings[b_color_key]
                        -%}
                        {%- if b_title != blank -%}
                          <div class="product-story__benefit">
                            <span
                              class="product-story__benefit-icon"
                              {% if b_color != blank %}
                                style="--benefit-bg: {{ b_color }};"
                              {% endif %}
                            >
                              {%- if b_icon != blank -%}
                                {{ b_icon | image_url: width: 96 | image_tag: widths: '48, 72, 96', loading: 'lazy' }}
                              {%- endif -%}
                            </span>
                            <div class="product-story__benefit-body">
                              <p class="product-story__benefit-title">{{ b_title | escape }}</p>
                              {%- if b_desc != blank -%}
                                <p class="product-story__benefit-desc">{{ b_desc | escape }}</p>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                    {%- if block.settings.points != blank -%}
                      {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
                      <ul class="product-story__points">
                        {%- for point in points -%}
                          {%- assign point_text = point | strip -%}
                          {%- if point_text != blank -%}
                            <li>{{ point_text | escape }}</li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                {%- when 'richtext' -%}
                  <div class="product-story__richtext rte">
                    {{ block.settings.content }}
                  </div>

                {%- when 'steps' -%}
                  <ol class="product-story__steps">
                    {%- assign step_number = 0 -%}
                    {%- for i in (1..6) -%}
                      {%- liquid
                        assign step_text_key = 'step_' | append: i | append: '_text'
                        assign step_title_key = 'step_' | append: i | append: '_title'
                        assign step_icon_key = 'step_' | append: i | append: '_icon'
                        assign step_text = block.settings[step_text_key]
                        assign step_title = block.settings[step_title_key]
                        assign step_icon = block.settings[step_icon_key]
                      -%}
                      {%- if step_text != blank -%}
                        {%- assign step_number = step_number | plus: 1 -%}
                        <li class="product-story__step">
                          <span class="product-story__step-number" aria-hidden="true">{{ step_number }}</span>
                          {%- if step_icon != blank -%}
                            <span class="product-story__step-icon">
                              {{ step_icon | image_url: width: 120 | image_tag: widths: '60, 90, 120', loading: 'lazy' }}
                            </span>
                          {%- endif -%}
                          <div class="product-story__step-body">
                            {%- if step_title != blank -%}
                              <p class="product-story__step-title">{{ step_title | escape }}</p>
                            {%- endif -%}
                            <p class="product-story__step-text">{{ step_text | escape }}</p>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ol>

                {%- when 'comparison' -%}
                  <div class="product-story__comparison">
                    <table class="product-story__table">
                      <thead>
                        <tr>
                          <th class="product-story__th product-story__th--feature">{{ block.settings.feature_label | default: 'Feature' | escape }}</th>
                          <th class="product-story__th product-story__th--col1">{{ block.settings.column1_label | default: 'Clear Whey' | escape }}</th>
                          <th class="product-story__th product-story__th--col2">{{ block.settings.column2_label | default: 'Regular Whey' | escape }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {%- for i in (1..6) -%}
                          {%- assign row_feature_key = 'row_' | append: i | append: '_feature' -%}
                          {%- assign row_col1_key = 'row_' | append: i | append: '_col1' -%}
                          {%- assign row_col2_key = 'row_' | append: i | append: '_col2' -%}
                          {%- assign row_feature = block.settings[row_feature_key] -%}
                          {%- if row_feature != blank -%}
                            <tr>
                              <td class="product-story__td product-story__td--feature">{{ row_feature | escape }}</td>
                              <td class="product-story__td product-story__td--col1">{{ block.settings[row_col1_key] | escape }}</td>
                              <td class="product-story__td product-story__td--col2">{{ block.settings[row_col2_key] | escape }}</td>
                            </tr>
                          {%- endif -%}
                        {%- endfor -%}
                      </tbody>
                    </table>
                    {%- if block.settings.table_footnote != blank -%}
                      <p class="product-story__footnote">{{ block.settings.table_footnote }}</p>
                    {%- endif -%}
                  </div>

              {%- endcase -%}
              </div>

              {%- if block.settings.button_label != blank -%}
                <div class="ps__panel-cta">
                  <a
                    class="ps__panel-button"
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                    {% else %}
                      href="#" aria-disabled="true"
                    {% endif %}
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                  {%- if block.settings.button_note != blank -%}
                    <span class="ps__panel-note">{{ block.settings.button_note | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {%- if ps_panel_img != blank -%}
              <div class="ps__panel-media">
                {{
                  ps_panel_img
                  | image_url: width: 1000
                  | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 25vw, 100vw', loading: 'lazy'
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var tablist = document.getElementById('PsTabs-{{ section.id }}');
    if (!tablist) return;
    var tabs = Array.prototype.slice.call(tablist.querySelectorAll('[role="tab"]'));
    var mobile = window.matchMedia('(max-width: 749px)');

    function activate(tab, opts) {
      tabs.forEach(function (t) {
        var selected = t === tab;
        t.setAttribute('aria-selected', selected ? 'true' : 'false');
        t.tabIndex = selected ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !selected;
      });
      if (opts && opts.focus) tab.focus();
      // On phones the card sits below the list, so bring it into view.
      if (opts && opts.scroll && mobile.matches) {
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        activate(tab, { scroll: true });
      });
      tab.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
        if (e.key === 'Home') next = tabs[0];
        if (e.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          e.preventDefault();
          activate(next, { focus: true });
        }
      });
    });

    // Theme editor: selecting a block in the sidebar shows its tab.
    document.addEventListener('shopify:block:select', function (e) {
      var tab = tablist.querySelector('[data-block-id="' + e.detail.blockId + '"]');
      if (tab) activate(tab);
    });
  })();
</script>

{% schema %}
{
  "name": "Product Story Tabs",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Small label above the heading. Leave empty to hide.",
      "default": "Clear whey · Four formulas"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What's your goal?"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "info": "Optional. Overrides the colour scheme background."
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "label": "Button background",
      "default": "#232428"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_bg_color",
      "label": "Active button + card background",
      "info": "The selected button and the card on the right share this colour. A block can override it.",
      "default": "#e3f0d0"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active button + card text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Card title colour",
      "info": "The big title in the card. Leave empty to use the product's custom.flavour_color metafield."
    },
    {
      "type": "header",
      "content": "Card image"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Default card image",
      "info": "Shown on the right of every card that has no image of its own. Recommended 800 × 1000 px."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
