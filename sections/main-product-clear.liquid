<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ request.origin | append: product.url | json }},
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if seo_media -%}
  "image": [{{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}],
  {%- elsif product.featured_image -%}
  "image": [{{ product.featured_image | image_url: width: 1920 | prepend: "https:" | json }}],
  {%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if product.type != blank -%}
  "category": {{ product.type | json }},
  {%- endif -%}
  {%- if product.tags.size > 0 -%}
  "keywords": {{ product.tags | join: ", " | json }},
  {%- endif -%}
  "countryOfOrigin": {
    "@type": "Country",
    "name": "IN"
  },
  {%- if product.selected_or_first_available_variant.sku != blank -%}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif -%}
  {%- if product.selected_or_first_available_variant.weight > 0 -%}
  "weight": {
    "@type": "QuantitativeValue",
    "value": {{ product.selected_or_first_available_variant.weight }},
    "unitCode": "GRM"
  },
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  {%- if has_reviews -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value.rating }},
    "bestRating": {{ product.metafields.reviews.rating.value.scale_max }},
    "worstRating": 1,
    "ratingCount": {{ rating_count }},
    "reviewCount": {{ rating_count }}
  },
  {%- endif -%}
  "offers": {
    "@type": "AggregateOffer",
    "offerCount": {{ product.variants.size }},
    "lowPrice": {{ product.variants | map: "price" | sort | first | divided_by: 100.0 }},
    "highPrice": {{ product.variants | map: "price" | sort | last | divided_by: 100.0 }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "name": "Return Policy",
      "url": "{{ shop.url }}/policies/refund-policy",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "applicableCountry": {{ shop.address.country_code | json }}
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": 0,
        "currency": {{ cart.currency.iso_code | json }}
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": {{ shop.address.country_code | json }}
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 2,
          "unitCode": "d"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 2,
          "maxValue": 5,
          "unitCode": "d"
        }
      }
    },
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "url": {{ request.origin | append: variant.url | json }},
        {%- if variant.featured_media -%}
        "image": {{ variant.featured_media | image_url: width: 1920 | prepend: "https:" | json }},
        {%- endif -%}
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "price": {{ variant.price | divided_by: 100.0 }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-12-31",
        {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
        {%- endif -%}
        {%- if variant.weight > 0 -%}
        "weight": {
          "@type": "QuantitativeValue",
          "value": {{ variant.weight }},
          "unitCode": "GRM"
        },
        {%- endif -%}
        {%- if variant.barcode.size == 8 -%}
        "gtin8": {{ variant.barcode | json }}
        {%- elsif variant.barcode.size == 12 -%}
        "gtin12": {{ variant.barcode | json }}
        {%- elsif variant.barcode.size == 13 -%}
        "gtin13": {{ variant.barcode | json }}
        {%- elsif variant.barcode.size == 14 -%}
        "gtin14": {{ variant.barcode | json }}
        {%- elsif variant.sku != blank -%}
        "mpn": {{ variant.sku | json }}
        {%- else -%}
        "mpn": {{ variant.id | json }}
        {%- endif -%}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
}
</script>

  </div>
</product-info>


<script>
function addActiveClass(element) {
    if (!element.classList.contains('active')) {
        element.classList.add('active'); // Add the 'active' class to the clicked element
    }
}
</script>

