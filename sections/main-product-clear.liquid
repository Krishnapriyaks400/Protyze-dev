{%- liquid
  assign pi_accent = section.settings.accent_color | default: '#f27a21'
  assign pi_bg = section.settings.product_bg_color
-%}
<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  style="background: {{ pi_bg }}; --pi-accent: {{ pi_accent }};"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'product-info-clear.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px !important;
        padding-bottom: {{ section.settings.padding_bottom }}px !important;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}
          {%- liquid
            assign trust_merged_into_card = false
            assign size_selector_merged_into_card = false
            for merge_check_block in section.blocks
              if merge_check_block.type == 'price_cart' and merge_check_block.settings.show_trust_row_in_card
                assign trust_merged_into_card = true
              endif
              if merge_check_block.type == 'price_cart' and merge_check_block.settings.show_size_selector_in_card
                assign size_selector_merged_into_card = true
              endif
            endfor
          -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
              {%- when 'collapsible_tab' -%}
                <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title inline-richtext">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                      </div>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>
              {%- when 'popup' -%}
                <modal-opener
                  class="product-popup-modal__opener quick-add-hidden"
                  data-modal="#PopupModal-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <button
                    id="ProductPopup-{{ block.id }}"
                    class="product-popup-modal__button link"
                    type="button"
                    aria-haspopup="dialog"
                  >
                    {{ block.settings.text | default: block.settings.page.title | escape }}
                  </button>
                </modal-opener>
              {%- when 'share' -%}
                {% liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  render 'share-button', block: block, share_link: share_url
                %}

              {%- when 'product_header' -%}
                {%- liquid
                  assign ph_title = block.settings.title_text | default: product.title
                  # Same flavour / serving size the selectors mark as selected.
                  assign ph_flavour_block = section.blocks | where: 'type', 'flavour_selector' | first
                  assign ph_flavour = ph_flavour_block.settings.current_flavour_text | default: product.metafields.custom.flavour_name.value
                  assign ph_flavour_color = product.metafields.custom.flavour_color.value

                  assign ph_size = product.metafields.custom.serving_size.value | default: product.metafields.custom.size_name.value
                  if ph_size == blank and product.has_only_default_variant == false
                    assign ph_size = product.selected_or_first_available_variant.title
                  endif
                -%}
                <div
                  class="pi-header"
                  {{ block.shopify_attributes }}
                >
                  <h1 class="pi-header__title">{{ ph_title | escape }}</h1>
                  {%- if ph_flavour != blank or ph_size != blank -%}
                    <div class="pi-header__pills">
                      {%- if ph_flavour != blank -%}
                        <span class="pi-pill">
                          <span class="pi-pill__dot" aria-hidden="true"{% if ph_flavour_color != blank %} style="background: {{ ph_flavour_color }};"{% endif %}></span>
                          {{ ph_flavour | escape }}
                        </span>
                      {%- endif -%}
                      {%- if ph_size != blank -%}
                        <span class="pi-pill">
                          {{ ph_size | escape }}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'short_description' -%}
                {%- liquid
                  assign sd_mf = product.metafields.custom.short_description
                  if sd_mf.type == 'single_line_text_field' or sd_mf.type == 'multi_line_text_field'
                    assign sd_text = sd_mf.value
                  else
                    assign sd_text = block.settings.text
                  endif
                -%}
                {%- if sd_text != blank -%}
                  <p class="pi-short-description" {{ block.shopify_attributes }}>{{ sd_text | escape }}</p>
                {%- endif -%}

              {%- when 'key_stats' -%}
                <div
                  class="pi-stats"
                  {{ block.shopify_attributes }}
                  style="{% if block.settings.bg_color != blank %}--pi-stats-bg: {{ block.settings.bg_color }};{% endif %}{% if block.settings.value_color != blank %} --pi-stats-value-color: {{ block.settings.value_color }};{% endif %}{% if block.settings.label_color != blank %} --pi-stats-label-color: {{ block.settings.label_color }};{% endif %}"
                >
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign stat_value_key = 'value_' | append: i
                      assign stat_label_key = 'label_' | append: i
                      assign stat_value = block.settings[stat_value_key]
                      assign stat_label = block.settings[stat_label_key]
                    -%}
                    {%- if stat_value != blank -%}
                      <div class="pi-stats__item">
                        <span class="pi-stats__value">{{ stat_value | escape }}</span>
                        {%- if stat_label != blank -%}
                          <span class="pi-stats__label">{{ stat_label | escape }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'combo_builder' -%}
                {% render 'combo-builder', block: block, product_form_id: product_form_id %}

              {%- when 'flavour_selector' -%}
                {% render 'product-siblings-selector', kind: 'flavour', product: product, block: block %}

              {%- when 'serving_size_selector' -%}
                {%- unless size_selector_merged_into_card -%}
                  {% render 'product-siblings-selector', kind: 'size', product: product, block: block %}
                {%- endunless -%}

              {%- when 'trust_badges' -%}
                {%- unless trust_merged_into_card -%}
                  {%- render 'product-trust-badges', block: block -%}
                {%- endunless -%}

              {%- when 'logo_row' -%}
                <div
                  class="pi-logo-row"
                  {{ block.shopify_attributes }}
                  style="--pi-logo-height: {{ block.settings.logo_height }}px; --pi-logo-gap: {{ block.settings.gap }}px; --pi-logo-tile-bg: {{ block.settings.tile_bg_color }}; --pi-logo-tile-padding: {{ block.settings.tile_padding }}px;"
                >
                  {%- for i in (1..6) -%}
                    {%- assign logo_key = 'image_' | append: i -%}
                    {%- assign logo = block.settings[logo_key] -%}
                    {%- if logo != blank -%}
                      <span class="pi-logo-row__tile">
                        <img
                          class="pi-logo-row__item"
                          src="{{ logo | image_url: height: 240 }}"
                          {% if logo.alt != blank %}
                            alt="{{ logo.alt | escape }}"
                          {% else %}
                            alt="" role="presentation"
                          {% endif %}
                          width="{{ logo.width }}"
                          height="{{ logo.height }}"
                          loading="lazy"
                        >
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- when 'product_tags' -%}
                {% render 'product-highlight-tags', block: block %}
              {%- when 'section_jump' -%}
                {% render 'product-section-jump', block: block %}
              {%- when 'variant_picker' -%}
                {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
              {%- when 'buy_buttons' -%}
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true
                -%}

              {%- when 'price_cart' -%}
                {{ 'pci-block.css' | asset_url | stylesheet_tag }}
                {%- liquid
                  assign pci_variant = product.selected_or_first_available_variant
                  assign pci_price = pci_variant.price
                  assign pci_compare = pci_variant.compare_at_price

                  assign pci_on_sale = false
                  if pci_compare > pci_price
                    assign pci_on_sale = true
                    assign pci_save_pct = pci_compare | minus: pci_price | times: 100 | divided_by: pci_compare | round
                  endif

                  assign pci_size_name = product.metafields.custom.serving_size.value
                  if pci_size_name == blank
                    assign pci_size_name = product.metafields.custom.size_name.value
                  endif
                  assign pci_servings = pci_size_name | split: ' ' | first | plus: 0
                -%}

                <div
                  class="pci-block"
                  {{ block.shopify_attributes }}
                  style="--pci-card-bg: {{ block.settings.card_bg_color }}; --pci-card-border: {{ block.settings.card_border_color }}; --pci-badge-text: {{ block.settings.badge_text_color }};{% if block.settings.badge_bg_color != blank %} --pci-badge-bg: {{ block.settings.badge_bg_color }};{% endif %}"
                >
                  {%- if block.settings.show_size_selector_in_card -%}
                    {%- render 'product-siblings-selector',
                      kind: 'size',
                      product: product,
                      block: block,
                      label: block.settings.size_selector_label
                    -%}
                  {%- endif -%}

                  {%- comment -%} Real price first and large, then compare-at, then save badge. {%- endcomment -%}
                  <div class="pci-price-row" id="price-{{ section.id }}" role="status">
                    <span class="pci-price" id="PciPrice-{{ section.id }}">
                      {{- pci_price | money_without_trailing_zeros -}}
                    </span>
                    <s class="pci-price__compare" id="PciCompare-{{ section.id }}"{% unless pci_on_sale %} hidden{% endunless %}>
                      {%- if pci_on_sale %}{{ pci_compare | money_without_trailing_zeros }}{% endif -%}
                    </s>
                    <span class="pci-price__badge" id="PciSaveBadge-{{ section.id }}"{% unless pci_on_sale %} hidden{% endunless %}>
                      {%- if pci_on_sale %}SAVE {{ pci_save_pct }}%{% endif -%}
                    </span>
                  </div>

                  {%- comment -%}
                    Per-serving price, e.g. "Rs. 180 per serving | 30 Servings".
                    Serving count is parsed from the serving_size metafield.
                  {%- endcomment -%}
                  {%- if block.settings.show_per_serving and pci_servings > 1 -%}
                    {%- assign pci_per_serving = pci_price
                      | times: 1.0
                      | divided_by: pci_servings
                      | divided_by: 100.0
                      | round
                      | times: 100
                    -%}
                    <p class="pci-block__per-serving">
                      {{ cart.currency.symbol }}{{ pci_per_serving | money_without_currency | remove: '.00' }} per serving
                      {%- assign pci_serving_note = block.settings.per_serving_note | default: 'inclusive of all taxes' -%}
                      {{- ' ' }}&middot; {{ pci_serving_note | escape }}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.autoapply_percent > 0 -%}
                    {%- liquid
                      assign pci_auto_multiplier = 100 | minus: block.settings.autoapply_percent | divided_by: 100.0
                      assign pci_auto_price = pci_price | times: pci_auto_multiplier | divided_by: 100.0 | round | times: 100
                      assign pci_save_money = pci_price | minus: pci_auto_price | money_without_trailing_zeros
                      assign pci_save_template = block.settings.autoapply_save_label | default: '−[amount] extra'
                      assign pci_save_label = pci_save_template | replace: '[amount]', pci_save_money

                      assign pci_offer_bg = block.settings.offer_bg_color
                      if pci_offer_bg == blank
                        assign pci_offer_bg = product.metafields.custom.product_bg_color.value | default: '#c8215a'
                      endif
                    -%}
                    {%- comment -%}
                      One coupon ticket in two parts: [Your price / new price] | [−₹X extra / ✓ note].
                    {%- endcomment -%}
                    <div
                      class="pci-offer-row"
                      id="PciOffer-{{ section.id }}"
                      data-percent="{{ block.settings.autoapply_percent }}"
                      data-save-label="{{ pci_save_template | escape }}"
                      style="--pci-offer-bg: {{ pci_offer_bg }}; --pci-offer-text: {{ block.settings.offer_text_color | default: '#ffffff' }};"
                    >
                      <div class="pci-offer pci-offer--price">
                        {%- if block.settings.offer_show_badge -%}
                          <span class="pci-offer__badge" aria-hidden="true">%</span>
                        {%- endif -%}
                        <div class="pci-offer__info">
                          <p class="pci-offer__lead">
                            {{ block.settings.autoapply_lead | default: 'Get this @' | escape }}
                            <s data-offer-was>{{ pci_price | money_without_trailing_zeros }}</s>
                          </p>
                          <p class="pci-offer__price" data-offer-price>{{ pci_auto_price | money_without_trailing_zeros }}</p>
                        </div>
                      </div>

                      <div
                        class="pci-offer pci-offer--extra"
                        style="{% if block.settings.save_card_bg_color != blank %}--pci-save-bg: {{ block.settings.save_card_bg_color }};{% endif %}{% if block.settings.save_card_text_color != blank %} --pci-save-text: {{ block.settings.save_card_text_color }};{% endif %}"
                      >
                        <p class="pci-offer__save" data-offer-save>{{ pci_save_label | escape }}</p>
                        {%- if block.settings.autoapply_text != blank -%}
                          <p class="pci-offer__note">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12.5 9.5 18 20 6"/></svg>
                            {{ block.settings.autoapply_text | escape }}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- comment -%} Native buy-buttons: qty stepper + add-to-cart. {%- endcomment -%}
                  <div class="pci-block__buy-wrap">
                    {%- render 'buy-buttons',
                      block: block,
                      product: product,
                      product_form_id: product_form_id,
                      section_id: section.id,
                      show_pickup_availability: true
                    -%}
                  </div>

                  {%- assign pci_trust_block = null -%}
                  {%- if block.settings.show_trust_row_in_card -%}
                    {%- assign pci_trust_block = section.blocks | where: 'type', 'trust_badges' | first -%}
                    {%- if pci_trust_block -%}
                      {%- render 'product-trust-badges', block: pci_trust_block, show_footnote: false -%}
                    {%- endif -%}
                  {%- endif -%}
                </div>

                {%- if pci_trust_block and pci_trust_block.settings.footnote != blank -%}
                  <p class="pi-trust__footnote pi-trust__footnote--below-card">{{ pci_trust_block.settings.footnote | escape }}</p>
                {%- endif -%}

                <script>
                  (function () {
                    var sid = '{{ section.id }}';
                    var priceEl = document.getElementById('PciPrice-' + sid);
                    var compareEl = document.getElementById('PciCompare-' + sid);
                    var badgeEl = document.getElementById('PciSaveBadge-' + sid);
                    var productData = {{ product | json }};
                    var moneyFormat = {{ shop.money_format | json }};

                    function formatMoney(cents) {
                      if (window.Shopify && window.Shopify.formatMoney) {
                        return window.Shopify.formatMoney(cents, moneyFormat).replace(/\.00$/, '');
                      }
                      return '{{ cart.currency.symbol }}' + Math.round(cents / 100).toLocaleString('en-IN');
                    }

                    function onVariantChange(variant) {
                      if (!variant) return;
                      if (priceEl) priceEl.textContent = formatMoney(variant.price);

                      var onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
                      if (compareEl) {
                        compareEl.textContent = onSale ? formatMoney(variant.compare_at_price) : '';
                        compareEl.hidden = !onSale;
                      }
                      if (badgeEl) {
                        var pct = onSale
                          ? Math.round((variant.compare_at_price - variant.price) / variant.compare_at_price * 100)
                          : 0;
                        badgeEl.textContent = onSale ? 'SAVE ' + pct + '%' : '';
                        badgeEl.hidden = !onSale;
                      }

                      var offerEl = document.getElementById('PciOffer-' + sid);
                      if (offerEl) {
                        var pctOff = parseFloat(offerEl.dataset.percent) || 0;
                        var autoPrice = Math.round(variant.price * (100 - pctOff) / 100 / 100) * 100;
                        offerEl.querySelector('[data-offer-price]').textContent = formatMoney(autoPrice);
                        var wasEl = offerEl.querySelector('[data-offer-was]');
                        if (wasEl) wasEl.textContent = formatMoney(variant.price);
                        offerEl.querySelector('[data-offer-save]').textContent = (offerEl.dataset.saveLabel || '').replace('[amount]', formatMoney(variant.price - autoPrice));
                      }
                    }

                    document.addEventListener('change', function (e) {
                      var t = e.target;
                      if (t && t.matches('input[name="id"], select[name="id"]')) {
                        var v = productData.variants.find(function (x) { return x.id === parseInt(t.value, 10); });
                        if (v) onVariantChange(v);
                      }
                    });

                    var productInfoEl = document.getElementById('MainProduct-' + sid);
                    if (productInfoEl) {
                      productInfoEl.addEventListener('variant:changed', function (e) {
                        if (e.detail && e.detail.variant) onVariantChange(e.detail.variant);
                      });
                    }
                  })();
