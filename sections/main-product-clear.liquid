      <script>
        (function () {
          var sid = '{{ section.id }}';
          var bar = document.getElementById('PiStickyAtc-' + sid);
          var mainBtn = document.getElementById('ProductSubmitButton-' + sid);
          if (!bar || !mainBtn || !('IntersectionObserver' in window)) return;

          var stickyBtn = bar.querySelector('.pi-sticky-atc__button');
          var mobile = window.matchMedia('(max-width: 749px)');
          var lastEntry = null;

          function setVisible(show) {
            bar.classList.toggle('is-visible', show);
            document.body.classList.toggle('pi-sticky-atc-open', show);
            if (show) {
              bar.removeAttribute('inert');
            } else {
              bar.setAttribute('inert', '');
            }
          }

          // Show only once the real button has scrolled up out of view.
          function update() {
            if (!lastEntry) return;
            setVisible(mobile.matches && !lastEntry.isIntersecting && lastEntry.boundingClientRect.top < 0);
          }

          new IntersectionObserver(function (entries) {
            lastEntry = entries[0];
            update();
          }).observe(mainBtn);

          mobile.addEventListener('change', update);

          // Reuse the real form so quantity, cart drawer and errors behave the same.
          stickyBtn.addEventListener('click', function () {
            var current = document.getElementById('ProductSubmitButton-' + sid) || mainBtn;
            current.click();
          });

          new MutationObserver(function () {
            stickyBtn.disabled = mainBtn.disabled;
          }).observe(mainBtn, { attributes: true, attributeFilter: ['disabled'] });
        })();
      </script>
