<script src="{{ 'cart-drawer-upsell.js' | asset_url }}" defer="defer"></script>
<style>
  .cart-drawer-upsell {
    padding: 14px 0 12px;
    border-top: 1px solid #e8e8e8;
    margin-bottom: 12px;
  }

  .cart-drawer-upsell__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .cart-drawer-upsell__heading {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
  }

  .cart-drawer-upsell__view-all {
    font-size: 12px;
    color: #333;
    text-decoration: none;
  }

  .cart-drawer-upsell__products {
    width: 100%;
    margin-bottom: 0;
  }

  .cart-drawer-upsell__products .carousel-cell {
    width: calc(50% - 6px);
    margin-right: 12px;
    height: auto;
  }

  .cart-drawer-upsell__product {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    height: 100%;
    overflow: hidden;
    border: 1px solid #e1e6e9;
    border-radius: 12px;
    background: #fff;
    color: #000;
  }
  .cart-drawer-upsell__product .cart-drawer-upsell__product-img{
    display: flex;
    justify-content: center;
}

  .cart-drawer-upsell__image {
    object-fit: contain;
    background: #f3f5f7;
    width: 100px;
    height: 100px;
    background: #f3f5f7;
  }

  .cart-drawer-upsell__details {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 9px;
  }

  .cart-drawer-upsell__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 36px;
    overflow: hidden;
    color: #252525;
    font-size: 13px;
    line-height: 1.4;
    text-decoration: none;
  }

  .cart-drawer-upsell__price {
    {% comment %} margin: 8px 0 12px; {% endcomment %}
    color: #222;
    font-size: 13px;
    font-weight: 600;
  }

  .cart-drawer-upsell__add {
      display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: auto;
    /* padding: 5px; */
    border: 2px solid #55d98a;
    border-radius: 12px;
    background: #fff;
    color: #176b42;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .cart-drawer-upsell__add span {
    font-size: 18px;
  }

  .cart-drawer-upsell .flickity-button {
    background: #fff;
    color: #263746;
    box-shadow: none;
  }

  .cart-drawer-upsell .flickity-prev-next-button {
    width: 25px;
    height: 35px;
  }

  .cart-drawer-upsell .flickity-prev-next-button.previous {
    left: -5px;
  }

  .cart-drawer-upsell .flickity-prev-next-button.next {
    right: -5px;
  }

  .cart-drawer-upsell .flickity-page-dots {
    position: relative;
    bottom: auto;
    margin-top: 12px;
  }

  .cart-drawer-upsell .flickity-page-dots .dot {
    width: 8px;
    height: 8px;
    background: #cbd2d9;
    opacity: 1;
  }

  .cart-drawer-upsell .flickity-page-dots .dot.is-selected {
    background: #17232d;
  }
  .cart-drawer-upsell__container{
    display: flex;
    align-items: center;
    margin-top: 10px;
    justify-content: space-between;
}
.cart-drawer-upsell__add:disabled {
  opacity: 0.65;
  cursor: wait;
}

.cart-drawer-upsell__add:hover:not(:disabled) {
  background: #eafff1;
}
</style>

{%- liquid
  assign upsell_collection_handle = ''

  for item in cart.items
    if item.product.tags contains 'anytime'
      assign upsell_collection_handle = 'upseller-anytime'
      break
    elsif item.product.tags contains 'yyy'
      assign upsell_collection_handle = 'related-yyy'
      break
    elsif item.product.tags contains 'zzz'
      assign upsell_collection_handle = 'related-zzz'
      break
    endif
  endfor

  assign upsell_collection = collections[upsell_collection_handle]
-%}

{%- if upsell_collection != blank -%}
  <div class="cart-drawer-upsell" data-cart-upsell>
    <div class="cart-drawer-upsell__header">
      <h3 class="cart-drawer-upsell__heading">You may also like</h3>

      <a
        class="cart-drawer-upsell__view-all"
        href="{{ upsell_collection.url }}"
      >
        View all
      </a>
    </div>

    <div class="cart-drawer-upsell__products">
      {%- assign upsell_count = 0 -%}

      {%- for product in upsell_collection.products -%}
        {%- assign already_in_cart = false -%}

        {%- for item in cart.items -%}
          {%- if item.product_id == product.id -%}
            {%- assign already_in_cart = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if already_in_cart == false and product.available -%}
          {%- assign upsell_variant = product.selected_or_first_available_variant -%}

          <div class="carousel-cell">
            <div class="cart-drawer-upsell__product">
              <a href="{{ product.url }}" class="cart-drawer-upsell__product-img">
                {%- if product.featured_image -%}
                  <img
                    class="cart-drawer-upsell__image"
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-drawer-upsell__details">
                <a
                  class="cart-drawer-upsell__title"
                  href="{{ product.url }}"
                >
                  {{ product.title | escape }}
                </a>
                <div class="cart-drawer-upsell__container">
                    <div class="cart-drawer-upsell__price">
                               {{ upsell_variant.price | money }}
                    </div>     
                    <button
                        type="button"
                        class="cart-drawer-upsell__add"
                        data-variant-id="{{ upsell_variant.id }}"
                        >
                        <span aria-hidden="true">+</span> Add
                        </button>
                 </div>
              </div>
            </div>
          </div>

          {%- assign upsell_count = upsell_count | plus: 1 -%}

          {%- if upsell_count >= 8 -%}
            {%- break -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<script>
  (() => {
    function initCartUpsellFlickity(root = document) {
      if (typeof Flickity === 'undefined') return;

      root.querySelectorAll('[data-cart-upsell]').forEach((carousel) => {
        const element = carousel.querySelector(
          '.cart-drawer-upsell__products'
        );

        if (!element || Flickity.data(element)) return;
        if (!element.querySelector('.carousel-cell')) return;

        new Flickity(element, {
          cellAlign: 'left',
          contain: true,
          wrapAround: false,
          prevNextButtons: true,
          pageDots: false,
          draggable: true,
          accessibility: true,
          imagesLoaded: true,
          adaptiveHeight: false
        });
      });
    }

    function start() {
      initCartUpsellFlickity();

      const observer = new MutationObserver(() => {
        initCartUpsellFlickity();
      });

      observer.observe(document.documentElement, {
        childList: true,
        subtree: true
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>