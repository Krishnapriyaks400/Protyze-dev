{%- comment -%}
  Line icons for the Nutrition & Usage section.
  Accepts: icon — one of the option values in that section's icon selects.
{%- endcomment -%}
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="#FFFF"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'person' -%}
      <circle cx="12" cy="4.5" r="2"/><path d="M12 7.5v6l-3 7M12 13.5l3 7M8 10.5h8"/>
    {%- when 'dumbbell' -%}
      <path d="M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12"/>
    {%- when 'cup' -%}
      <path d="M7 8h10l-1.2 13H8.2L7 8z"/><path d="M6 8h12M10 8l.8-4h2.4"/>
    {%- when 'bottle' -%}
      <rect x="6" y="7" width="12" height="14" rx="2"/><path d="M9 7V4h6v3M12 11v6M9 14h6"/>
    {%- when 'bolt' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'loop' -%}
      <path d="M8 4H6a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h12a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3H6"/><path d="M9 20l-3-3 3-3"/>
    {%- when 'heart' -%}
      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>
    {%- when 'glass' -%}
      <path d="M6 3h12l-1.5 18h-9L6 3z"/><path d="M6.6 9h10.8"/>
    {%- when 'moon' -%}
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
    {%- when 'flask' -%}
      <path d="M9 3h6M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2h12.4a1.5 1.5 0 0 0 1.3-2L14 9V3"/><path d="M7.5 14h9"/>
    {%- when 'shaker' -%}
      <path d="M8 3h8v3H8zM7 6h10l-1 15H8L7 6z"/><path d="M7.4 11h9.2"/>
    {%- when 'snowflake' -%}
      <path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7"/><path d="M9.5 3.5 12 6l2.5-2.5M9.5 20.5 12 18l2.5 2.5M3.2 10.5l3.4-.9-.9-3.4M20.8 13.5l-3.4.9.9 3.4M3.2 13.5l3.4.9-.9 3.4M20.8 10.5l-3.4-.9.9-3.4"/>
    {%- when 'drop' -%}
      <path d="M12 3s6.5 6.8 6.5 11.2a6.5 6.5 0 0 1-13 0C5.5 9.8 12 3 12 3z"/>
    {%- when 'feather' -%}
      <path d="M20.2 3.8C14 3.5 8 7.5 6.5 14.5L4 20"/><path d="M20.2 3.8c-.4 6-4.4 11.6-11.6 12.8"/><path d="M8.6 16.6H14"/>
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
  {%- endcase -%}
</svg>
