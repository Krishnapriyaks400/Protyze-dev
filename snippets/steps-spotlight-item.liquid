{%- comment -%}
  One step row in the Steps Spotlight section. Used for both block steps
  and steps that come from "How to use step" metaobjects.

  Accepts:
  - index: {Number} Step number
  - title: {String}
  - text: {String}
  - image: {Object} Image (optional)
  - color: {String} Number circle colour (optional, already filtered by the section)
  - attributes: {String} block.shopify_attributes (optional)
{%- endcomment -%}
<li
  class="ss__step"
  {{ attributes }}
  {% if color != blank %}
    style="--ss-step-bg: {{ color }};"
  {% endif %}
>
  <span class="ss__number" aria-hidden="true">{{ index }}</span>
  {%- if image != blank -%}
    <span class="ss__thumb">
      {{ image | image_url: width: 480 | image_tag: widths: '160, 240, 320, 480', sizes: '(min-width: 750px) 160px, 112px', loading: 'lazy', alt: title }}
    </span>
  {%- endif -%}
  <div class="ss__copy">
    {%- if title != blank -%}
      <p class="ss__title">{{ title | escape }}</p>
    {%- endif -%}
    {%- if text != blank -%}
      <p class="ss__text">{{ text | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>
</li>
