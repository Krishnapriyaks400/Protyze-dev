{%- comment -%}
  Product Group Selector
  Shows flavour pills + size cards for products in a collection.
  Each product needs these metafields:
    - custom.group_flavour (single_line_text) e.g. "Pink Guava"
    - custom.group_flavour_color (color) e.g. "#e91e63"
    - custom.group_size (single_line_text) e.g. "30 Servings"
    - custom.group_size_subtitle (single_line_text) e.g. "1 Kg Jar"
{%- endcomment -%}

{%- assign grp_collection = block.settings.group_collection -%}
{%- if grp_collection != blank and grp_collection.products.size > 0 -%}

  <div class="product-group" id="ProductGroup-{{ section.id }}" {{ block.shopify_attributes }}>
    <script type="application/json" id="ProductGroupData-{{ section.id }}">
      [
        {%- for p in grp_collection.products -%}
          {
            "id": {{ p.id }},
            "url": {{ p.url | json }},
            "flavour": {{ p.metafields.custom.flavour_name | default: p.title | json }},
            "image": {{ p.featured_image | image_url: width: 80 | json }},
            "size": {{ p.metafields.custom.size_name | default: "" | json }},
            "sizeSubtitle": {{ p.metafields.custom.size_subtitle | default: "" | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>

    <div class="product-group__section">
      <p class="product-group__label">
        {{ block.settings.flavour_label | default: 'Flavour' | escape }}:
        <strong id="ProductGroupActiveFlavour-{{ section.id }}"></strong>
      </p>
      <div class="product-group__flavours" id="ProductGroupFlavours-{{ section.id }}"></div>
    </div>

    <div class="product-group__section" id="ProductGroupSizeSection-{{ section.id }}" style="display:none;">
      <p class="product-group__label">
        {{ block.settings.size_label | default: 'SIZE' | escape }}:
        <strong id="ProductGroupActiveSize-{{ section.id }}"></strong>
      </p>
      <div class="product-group__sizes" id="ProductGroupSizes-{{ section.id }}"></div>
    </div>
  </div>

  <style>
    .product-group__section {
      margin-bottom: 2rem;
    }
    .product-group__label {
      font-family: var(--font-body-family);
      font-size: 1.4rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(var(--color-foreground), 0.7);
      margin: 0 0 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .product-group__label strong {
      color: rgb(var(--color-foreground));
      text-transform: uppercase;
    }
    .product-group__flavours {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .product-group__flavour-btn {
      display: block;
      padding: 0;
      border: 2px solid rgba(var(--color-foreground), 0.15);
      border-radius: 3px;
      background: none;
      cursor: pointer;
      overflow: hidden;
      width: 6.4rem;
      height: 6.4rem;
      transition: border-color 0.2s ease;
    }
    .product-group__flavour-btn:hover {
      border-color: rgba(var(--color-foreground), 0.4);
    }
    .product-group__flavour-btn--active {
      border-color: rgb(var(--color-foreground));
    }
    .product-group__flavour-img {
      width: 100%;
      height: 100%;
    }
    .product-group__flavour-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .product-group__sizes {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .product-group__size-btn {
      display: flex;
      flex-direction: column;
      padding: 1.4rem 2.4rem;
      border: 1.5px solid rgba(var(--color-foreground), 0.15);
      border-radius: 3px;
      background: rgb(var(--color-background));
      cursor: pointer;
      text-decoration: none;
      transition: border-color 0.2s ease;
      min-width: 14rem;
    }
    .product-group__size-btn:hover {
      border-color: rgba(var(--color-foreground), 0.4);
    }
    .product-group__size-btn--active {
      background: rgb(var(--color-foreground));
      border-color: rgb(var(--color-foreground));
    }
    .product-group__size-btn--active .product-group__size-name,
    .product-group__size-btn--active .product-group__size-sub {
      color: rgb(var(--color-background));
    }
    .product-group__size-name {
      font-family: var(--font-custom-family, var(--font-body-family));
      font-size: 1.6rem;
      font-weight: 700;
      color: rgb(var(--color-foreground));
      line-height: 1.3;
    }
    .product-group__size-sub {
      font-family: var(--font-body-family);
      font-size: 1.3rem;
      color: rgba(var(--color-foreground), 0.55);
      margin-top: 0.2rem;
    }

    @media screen and (max-width: 749px) {
      .product-group__flavour-btn {
        width: 5.6rem;
        height: 5.6rem;
      }
      .product-group__size-btn {
        padding: 1.2rem 1.8rem;
        min-width: 12rem;
      }
      .product-group__size-name {
        font-size: 1.4rem;
      }
    }
  </style>

  <script>
    (function() {
      var sid = '{{ section.id }}';
      var currentId = {{ product.id }};
      var products = JSON.parse(document.getElementById('ProductGroupData-' + sid).textContent);

      var current = products.find(function(p) { return p.id === currentId; });
      if (!current) return;

      var flavourNames = [];
      var seenFlavour = {};
      products.forEach(function(p) {
        if (!seenFlavour[p.flavour]) {
          seenFlavour[p.flavour] = true;
          flavourNames.push(p.flavour);
        }
      });

      function getFlavourImage(flavour) {
        var match = products.find(function(p) { return p.flavour === flavour && p.size === current.size; });
        if (!match) match = products.find(function(p) { return p.flavour === flavour; });
        return match ? match.image : '';
      }

      var flavourContainer = document.getElementById('ProductGroupFlavours-' + sid);
      var sizeContainer = document.getElementById('ProductGroupSizes-' + sid);
      var sizeSection = document.getElementById('ProductGroupSizeSection-' + sid);
      var activeFlavourEl = document.getElementById('ProductGroupActiveFlavour-' + sid);
      var activeSizeEl = document.getElementById('ProductGroupActiveSize-' + sid);
      var selectedFlavour = current.flavour;

      function renderFlavours() {
        flavourContainer.innerHTML = '';
        flavourNames.forEach(function(name) {
          var img = getFlavourImage(name);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'product-group__flavour-btn' + (name === selectedFlavour ? ' product-group__flavour-btn--active' : '');
          btn.innerHTML = img ? '<span class="product-group__flavour-img"><img src="' + img + '" alt="' + name + '" loading="lazy"></span>' : name;
          btn.addEventListener('click', function() { selectFlavour(name); });
          flavourContainer.appendChild(btn);
        });
        activeFlavourEl.textContent = selectedFlavour;
      }

      function renderSizes(flavour) {
        var matches = products.filter(function(p) { return p.flavour === flavour; });
        sizeContainer.innerHTML = '';

        if (matches.length <= 1 && (!matches[0] || !matches[0].size)) {
          sizeSection.style.display = 'none';
          return;
        }

        var hasSize = matches.some(function(m) { return m.size; });
        if (!hasSize) { sizeSection.style.display = 'none'; return; }

        sizeSection.style.display = '';
        activeSizeEl.textContent = current.size;
        matches.forEach(function(m) {
          if (!m.size) return;
          var btn = document.createElement('a');
          btn.href = m.url;
          btn.className = 'product-group__size-btn' + (m.id === currentId ? ' product-group__size-btn--active' : '');
          btn.innerHTML = '<span class="product-group__size-name">' + m.size + '</span>' + (m.sizeSubtitle ? '<span class="product-group__size-sub">' + m.sizeSubtitle + '</span>' : '');
          sizeContainer.appendChild(btn);
        });
      }

      function selectFlavour(flavour) {
        if (flavour === current.flavour) return;
        var matches = products.filter(function(p) { return p.flavour === flavour; });
        var target = matches.find(function(m) { return m.size === current.size; }) || matches[0];
        if (target) window.location.href = target.url;
      }

      renderFlavours();
      renderSizes(selectedFlavour);
    })();
  </script>

{%- endif -%}
