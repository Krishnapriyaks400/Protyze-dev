{%- assign swatch_collection = block.settings.swatch_collection -%}
{%- assign swatch_label = block.settings.swatch_label | default: 'Flavour' -%}

{%- if swatch_collection != blank and swatch_collection.products.size > 1 -%}
  <div class="collection-swatches" {{ block.shopify_attributes }}>
    <p class="collection-swatches__label">
      {{ swatch_label }}: <strong>{{ product.title | escape }}</strong>
    </p>
    <div class="collection-swatches__grid">
      {%- for swatch_product in swatch_collection.products -%}
        <a
          href="{{ swatch_product.url }}"
          class="collection-swatches__item{% if swatch_product.id == product.id %} collection-swatches__item--active{% endif %}"
          title="{{ swatch_product.title | escape }}"
        >
          {%- if swatch_product.featured_image != blank -%}
            {{ swatch_product.featured_image | image_url: width: 160 | image_tag: widths: '80, 120, 160', loading: 'lazy', alt: swatch_product.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .collection-swatches__label {
      font-family: var(--font-body-family);
      font-size: 1.5rem;
      margin: 0 0 1.2rem;
      color: rgb(var(--color-foreground));
    }

    .collection-swatches__grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .collection-swatches__item {
      display: block;
      width: 6.4rem;
      height: 6.4rem;
      border-radius: 3px;
      border: 2px solid transparent;
      overflow: hidden;
      transition: border-color 0.2s ease;
      background: rgb(var(--color-background));
    }

    .collection-swatches__item:hover {
      border-color: rgba(var(--color-foreground), 0.4);
    }

    .collection-swatches__item--active {
      border-color: rgb(var(--color-foreground));
    }

    .collection-swatches__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>
{%- endif -%}
