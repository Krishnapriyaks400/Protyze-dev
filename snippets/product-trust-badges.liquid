{%- comment -%}
  Renders the 3-icon trust-badge row + footnote. Shared by the standalone
  "Trust badges" block and the Price + Cart card (when its "Show trust
  badges in this card" toggle is on).

  Accepts:
  - block: any block whose settings include icon_1..3 / title_1..3 /
    subtitle_1..3 / footnote (i.e. a 'trust_badges' block's settings)
  - show_footnote: optional, defaults to true. Pass false to render only
    the icon row (used when the footnote needs to sit outside a wrapping
    card instead of inside it).
{%- endcomment -%}
<div class="pi-trust" {{ block.shopify_attributes }}>
  <div class="pi-trust__row">
    {%- for i in (1..3) -%}
      {%- liquid
        assign trust_icon_key = 'icon_' | append: i
        assign trust_title_key = 'title_' | append: i
        assign trust_sub_key = 'subtitle_' | append: i
        assign trust_icon = block.settings[trust_icon_key]
        assign trust_title = block.settings[trust_title_key]
        assign trust_sub = block.settings[trust_sub_key]
      -%}
      {%- if trust_title != blank -%}
        <div class="pi-trust__item">
          <svg class="pi-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- case trust_icon -%}
              {%- when 'shield' -%}
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
              {%- when 'return' -%}
                <path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
              {%- when 'check' -%}
                <circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/>
              {%- when 'leaf' -%}
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              {%- else -%}
                <path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            {%- endcase -%}
          </svg>
          <span class="pi-trust__title">{{ trust_title | escape }}</span>
          {%- if trust_sub != blank -%}
            <span class="pi-trust__sub">{{ trust_sub | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if show_footnote != false and block.settings.footnote != blank -%}
    <p class="pi-trust__footnote">{{ block.settings.footnote | escape }}</p>
  {%- endif -%}
</div>
